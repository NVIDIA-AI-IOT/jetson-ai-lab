---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ModelServeSection from '../../components/ModelServeSection.astro';
import ModelCallSection from '../../components/ModelCallSection.astro';
import ModelBenchmarkSection from '../../components/ModelBenchmarkSection.astro';
import ModelOneShotSection from '../../components/ModelOneShotSection.astro';
import ModelShaderCanvas from '../../components/ModelShaderCanvas.astro';
import { getSupportedInferenceEngines, sortEnginesForUi } from '../../lib/modelFrontmatterAdapter';
import { isModelNew, MODEL_NEW_WINDOW_DAYS } from '../../lib/modelFreshness';
import { modalityIcon, modalityLabel } from '../../lib/modelModalities';
import { modelFamilyVisual } from '../../data/modelVisuals';
import { modelShaderDefaults } from '../../data/modelShaderDefaults.mjs';
import benchmarksData from '../../data/benchmarks.json';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;
const modelIsNew = isModelNew(data);
const hasFreshnessMetadata = data.catalog_added_at !== undefined || data.is_new !== undefined;
const familyVisual = modelFamilyVisual(data.visual_family, data.visual_variant);
const isMinistralVisual = data.visual_family === 'mistral-ministral3';
const visualCardOpacity = isMinistralVisual ? 0.68 : 0.5;
const familyHeroFallback = familyVisual?.assets.hero;
const familyShaderConfig = {
  qwen: { shaderId: 'qwen' as const, startTime: 7, resolutionScale: 0.8 },
  gemma: {
    shaderId: 'gemma' as const,
    startTime: 11,
    resolutionScale: data.visual_variant === '4' ? 0.5 : 0.7,
  },
  'liquid-d1': { shaderId: 'liquid' as const, startTime: 13, resolutionScale: 0.75 },
  'meta-llama': { shaderId: 'llama' as const, startTime: 9, resolutionScale: 0.75 },
  'meta-muse-glimmer': { shaderId: 'muse-glimmer' as const, startTime: 21, resolutionScale: 1 },
  'openai-gpt-oss': { shaderId: 'gpt-oss' as const, startTime: 16, resolutionScale: 1 },
  'mistral-ministral3': { shaderId: 'ministral3' as const, startTime: 18, resolutionScale: 1 },
  'minimax-m2': { shaderId: 'minimax' as const, startTime: 15, resolutionScale: 0.75 },
  'flux3-action': { shaderId: 'flux-action' as const, startTime: 18, resolutionScale: 0.75 },
  'nvidia-nemotron': { shaderId: 'nemotron' as const, startTime: 60, resolutionScale: 1 },
  'nvidia-cosmos': { shaderId: 'cosmos' as const, startTime: 24, resolutionScale: 0.75 },
} as const;
const familyShaderBase = data.visual_family
  ? familyShaderConfig[data.visual_family as keyof typeof familyShaderConfig]
  : undefined;
const familyShader = familyShaderBase
  ? { ...familyShaderBase, defaults: modelShaderDefaults(familyShaderBase.shaderId, data.visual_variant) }
  : undefined;

// Generate HuggingFace URL from hf_checkpoint if huggingface_url not provided
const huggingfaceUrl = data.huggingface_url || (data.hf_checkpoint ? `https://huggingface.co/${data.hf_checkpoint}` : null);
const isGemma4Family = data.family === 'Google Gemma4';

const sortedEngines = sortEnginesForUi(getSupportedInferenceEngines(data));

const benchmarkEntry = data.benchmark_key
  ? ((benchmarksData.models as any[]).find((m) => m.name === data.benchmark_key) ?? null)
  : null;

const allModelEntries = await getCollection('models');
const benchmarkSeries = (data.benchmark_series ?? [])
  .map((k) => {
    const bm = (benchmarksData.models as any[]).find((m) => m.name === k) ?? null;
    if (!bm) return null;
    const page = allModelEntries.find((m) => m.data.benchmark_key === k);
    return { ...bm, link: page ? `/models/${page.slug}#model-benchmark` : null };
  })
  .filter((m): m is NonNullable<typeof m> => m !== null);

// Per-token precision pill — colors match benchmark bar palette
function precisionPill(token: string) {
  const p = token.toUpperCase().trim();
  if (/NVFP4/.test(p))
    return { bg: 'rgba(168,85,247,0.15)', border: '#A855F7', color: '#D8B4FE' };  // vivid purple (Blackwell-accelerated)
  if (/FP4|INT4|W4|NF4|Q[2-8]_K|Q[2-8]_[0-9]|IQ[2-4]|Q4|4[_\-]?BIT|AWQ|MXFP4/.test(p))
    return { bg: 'rgba(124,111,160,0.15)', border: '#7C6FA0', color: '#B8ADCC' }; // dull gray-purple (other 4-bit)
  if (/FP8|INT8|W8|Q8/.test(p))
    return { bg: 'rgba(118,185,0,0.15)', border: '#76B900', color: '#AADD44' };   // NVIDIA green (8-bit)
  return { bg: 'rgba(0,102,102,0.15)', border: '#008080', color: '#4DD9D9' };     // teal (16-bit+)
}
const precisionTokens = data.precision.split(/[\/,]/).map((t: string) => t.trim()).filter(Boolean);

const inputModalities = data.input_modalities?.length
  ? data.input_modalities
  : data.modalities?.map((modality: string) => modality.toLowerCase())
    ?? (data.vision_capable ? ['text', 'image'] : ['text']);
const outputModalities = data.output_modalities?.length
  ? data.output_modalities
  : data.type === 'Image'
    ? ['image']
    : data.type === 'Audio'
      ? ['audio']
      : ['text'];

const inferenceNeedsHfToken = sortedEngines.some((e) => {
  const cmds = [
    e.serve_command_orin,
    e.serve_command_thor,
    e.run_command_orin,
    e.run_command_thor,
    e.run_command,
  ];
  return cmds.some((c) => c && c.includes('HF_TOKEN'));
});
---

<Layout title={data.title} description={data.short_description}>
  {/* Hero Section */}
  <section
    class="relative overflow-hidden bg-nvidia-black text-nvidia-white py-20"
    style={familyVisual ? `background-color:${familyVisual.palette.background}` : undefined}
    data-model-visual-hero={familyVisual ? '' : undefined}
  >
    {familyVisual && (
      <>
        <div
          class="pointer-events-none absolute inset-0"
          data-model-visual-art
          aria-hidden="true"
        >
          <img
            src={familyHeroFallback}
            alt=""
            class="absolute inset-0 h-full w-full object-cover"
            style={isMinistralVisual ? 'filter:blur(2.5px);transform:scale(1.012)' : undefined}
          />
          {familyShader && (
            <ModelShaderCanvas
              shaderId={familyShader.shaderId}
              instanceId={`model-${entry.slug}`}
              defaults={familyShader.defaults}
              startTime={familyShader.startTime}
              maxFps={20}
              resolutionScale={familyShader.resolutionScale}
              class="absolute inset-0 h-full w-full"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-r from-black via-black/75 to-black/20"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/25"></div>
          {isMinistralVisual && <div class="absolute inset-0 bg-black/30"></div>}
        </div>
        <button
          type="button"
          class="model-visual-toggle absolute right-4 top-3 z-[2] inline-flex items-center gap-2 rounded border border-white/10 bg-black/25 px-2.5 py-1.5 text-[11px] font-medium tracking-wide text-white/55 transition hover:border-white/25 hover:bg-black/45 hover:text-white/85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-nvidia-green sm:right-6 lg:right-8"
          data-model-visual-toggle
          aria-pressed="true"
          aria-label="Turn model visual off"
        >
          <span>Model visual</span>
          <span class="model-visual-switch relative h-3.5 w-7 rounded-[4px] border border-white/15 bg-[#76b900]/45 transition-colors" aria-hidden="true">
            <span class="model-visual-thumb absolute left-[2px] top-[2px] h-2 w-2 translate-x-[14px] rounded-[2px] bg-white/80 transition-transform"></span>
          </span>
          <span class="w-5 text-left" data-model-visual-state>On</span>
        </button>
      </>
    )}
    <div class="relative z-[1] max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="flex items-center space-x-3 mb-6">
            {hasFreshnessMetadata && (
              <span
                data-model-new-badge
                data-catalog-added-at={data.catalog_added_at}
                data-new-until={data.new_until}
                data-legacy-is-new={String(data.is_new === true)}
                data-new-window-days={MODEL_NEW_WINDOW_DAYS}
                class:list={["bg-nvidia-green text-nvidia-black px-4 py-2 rounded-full text-sm font-semibold", { hidden: !modelIsNew }]}
              >New</span>
            )}
            {data.type && (
              <span class="text-nvidia-gray-300 font-semibold text-lg">{data.type}</span>
            )}
          </div>
          <h1 class="text-5xl font-bold mb-6">{data.title}</h1>
          <p class="text-xl text-nvidia-gray-300 mb-8 leading-relaxed">
            {data.short_description}
          </p>
          
          {/* Page ToC chips */}
          <div class="flex flex-wrap gap-2 mt-2">
            {!data.hide_run_button && sortedEngines.length > 0 && (
              <a
                href="#run-on-jetson"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-[#76b900]/60 text-nvidia-gray-200 hover:bg-[#76b900]/10 hover:text-white transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-nvidia-green flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M2 5a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm3.293 1.293a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 01-1.414-1.414L7.586 10 5.293 7.707a1 1 0 010-1.414zM11 12a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
                </svg>
                Command to Run on Jetson
              </a>
            )}
            {benchmarkEntry && (
              <a
                href="#model-benchmark"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-[#76b900]/60 text-nvidia-gray-200 hover:bg-[#76b900]/10 hover:text-white transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-nvidia-green flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z" />
                </svg>
                Benchmark
              </a>
            )}
            <a
              href="#model-details"
              class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-[#76b900]/60 text-nvidia-gray-200 hover:bg-[#76b900]/10 hover:text-white transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-nvidia-green flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z" />
              </svg>
              Model Details
            </a>
          </div>
        </div>
        <div
          class:list={["rounded-xl p-8 border border-nvidia-gray-700", familyVisual ? "shadow-2xl" : "bg-nvidia-gray-800"]}
          style={familyVisual ? `background-color:rgba(0,0,0,${visualCardOpacity})` : undefined}
          data-model-visual-card={familyVisual ? '' : undefined}
          data-model-visual-card-opacity={familyVisual ? String(visualCardOpacity) : undefined}
        >
          <div class="divide-y divide-nvidia-gray-700">

            {/* Parameters */}
            {(data.parameters || data.model_size) && (
              <div class="flex justify-between items-start py-3 gap-4">
                <span class="text-nvidia-gray-300 font-medium shrink-0">Parameters</span>
                <span class="font-bold text-nvidia-white text-right">{data.parameters ?? data.model_size}</span>
              </div>
            )}

            {/* Directional modalities */}
            {inputModalities.length > 0 && (
              <div class="flex justify-between items-center py-3 gap-4">
                <span class="text-nvidia-gray-300 font-medium shrink-0">Inputs</span>
                <div class="flex flex-wrap gap-1.5 justify-end">
                  {inputModalities.map((modality: string) => (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);color:#94A3B8">
                      <svg class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor"><Fragment set:html={modalityIcon(modality)}/></svg>
                      {modalityLabel(modality, 'input')}
                    </span>
                  ))}
                </div>
              </div>
            )}
            {outputModalities.length > 0 && (
              <div class="flex justify-between items-center py-3 gap-4">
                <span class="text-nvidia-gray-300 font-medium shrink-0">Outputs</span>
                <div class="flex flex-wrap gap-1.5 justify-end">
                  {outputModalities.map((modality: string) => (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);color:#94A3B8">
                      <svg class="w-3 h-3 shrink-0" viewBox="0 0 20 20" fill="currentColor"><Fragment set:html={modalityIcon(modality)}/></svg>
                      {modalityLabel(modality, 'output')}
                    </span>
                  ))}
                </div>
              </div>
            )}

            {/* Context Length */}
            {data.context_length && (
              <div class="flex justify-between items-center py-3 gap-4">
                <span class="text-nvidia-gray-300 font-medium shrink-0">Context Length</span>
                <span class="font-bold text-nvidia-white">{data.context_length}</span>
              </div>
            )}

            {/* License */}
            {data.license && (
              <div class="flex justify-between items-start py-3 gap-4">
                <span class="text-nvidia-gray-300 font-medium shrink-0">License</span>
                <span class="font-bold text-nvidia-white text-right">{data.license}</span>
              </div>
            )}

            {/* Precision */}
            <div class="flex justify-between items-center py-3 gap-4">
              <span class="text-nvidia-gray-300 font-medium shrink-0">Precision</span>
              <div class="flex flex-wrap gap-1.5 justify-end">
                {precisionTokens.map((token: string) => {
                  const pill = precisionPill(token);
                  return (
                    <span style={`background:${pill.bg};border:1px solid ${pill.border};color:${pill.color};padding:0.2rem 0.6rem;border-radius:9999px;font-size:0.78rem;font-weight:600;letter-spacing:0.02em;`}>
                      {token}
                    </span>
                  );
                })}
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  {!data.hide_run_button && sortedEngines.length > 0 && (
    <div id="run-on-jetson" class="scroll-mt-20">
      <section
        id="serve-model-and-call"
        class="bg-nvidia-gray-50 border-b border-nvidia-gray-200 relative overflow-hidden scroll-mt-20"
        aria-labelledby="serve-the-model-heading"
      >
        <div
          class="pointer-events-none absolute inset-0 bg-cover bg-center bg-no-repeat opacity-[0.12]"
          style="background-image: url('/images/inference-call-band.png');"
          aria-hidden="true"
        />
        <div class="relative z-[1]">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
            <h2 id="serve-the-model-heading" class="text-3xl font-bold text-nvidia-black mb-0">
              Serve the model
            </h2>
          </div>
          <ModelServeSection
            modelSlug={entry.slug}
            engines={sortedEngines}
            needsHfToken={inferenceNeedsHfToken}
            matrixModulesDisabled={data.matrix_modules_disabled}
            sectionClass="!bg-transparent !border-b-0 !scroll-mt-0 pt-8 pb-8"
          />
          <ModelCallSection
            modelSlug={entry.slug}
            engines={sortedEngines}
            hfCheckpoint={data.hf_checkpoint}
            clientCall={data.client_call}
            sectionClass="!bg-transparent !border-b-0 !border-t-0 !scroll-mt-0 pt-10 pb-16"
          />
        </div>
      </section>
      <ModelOneShotSection oneShot={data.one_shot_inference} modelSlug={entry.slug} />
    </div>
  )}

  {benchmarkEntry && (
    <ModelBenchmarkSection entry={benchmarkEntry} seriesEntries={benchmarkSeries} />
  )}

  {/* Model Details / Description Section */}
  <section id="model-details" class="py-16 bg-nvidia-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <h2 class="text-3xl font-bold text-nvidia-black">Model Details</h2>
        
        {/* External Resources - next to Model Details heading */}
        {(data.build_nvidia_url || huggingfaceUrl) && (
          <div class="flex flex-wrap gap-3">
            {data.build_nvidia_url && (
              <a 
                href={data.build_nvidia_url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="relative inline-flex items-center gap-2 rounded-lg border border-gray-700 bg-black px-4 pt-2.5 pb-4 font-semibold text-white transition-colors hover:bg-gray-800 after:absolute after:right-4 after:bottom-2 after:left-4 after:h-[3px] after:rounded-full after:bg-[#76b900] after:content-['']"
              >
                <img src="https://www.nvidia.com/favicon.ico" alt="NVIDIA" class="h-5 w-5 brightness-0 invert" />
                Try on build.nvidia.com
              </a>
            )}
            {huggingfaceUrl && (
              <a 
                href={huggingfaceUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="relative inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-100 px-4 pt-2.5 pb-4 font-semibold text-black transition-colors hover:bg-gray-200 after:absolute after:right-4 after:bottom-2 after:left-4 after:h-[3px] after:rounded-full after:bg-[#FFD21E] after:content-['']"
              >
                <img src="/images/icons/hf-logo.png" alt="HuggingFace" class="w-5 h-5" />
                View on HuggingFace
              </a>
            )}
          </div>
        )}
      </div>
      {isGemma4Family && (
        <p class="mb-6 rounded-lg border border-nvidia-gray-200 bg-nvidia-gray-50 px-4 py-3 text-sm text-nvidia-gray-700">
          If you want to learn more about the Gemma 4 family and the different ways to run it on Jetson, check out the{' '}
          <a href="/tutorials/gemma4-on-jetson" class="font-semibold text-nvidia-green hover:underline">
            Gemma 4 on Jetson tutorial
          </a>
          .
        </p>
      )}
      <div class="prose prose-lg text-nvidia-gray-600 max-w-none">
        <Content />
      </div>
    </div>
  </section>
</Layout>

<script>
  function refreshModelNewBadge() {
    const badge = document.querySelector<HTMLElement>('[data-model-new-badge]');
    if (!badge) return;

    const addedDate = badge.dataset.catalogAddedAt;
    const newUntilDate = badge.dataset.newUntil;
    const dayMs = 24 * 60 * 60 * 1000;
    let isNew = badge.dataset.legacyIsNew === 'true';

    if (addedDate) {
      const addedAt = Date.parse(`${addedDate}T00:00:00Z`);
      const now = Date.now();
      if (!Number.isFinite(addedAt) || now < addedAt) {
        isNew = false;
      } else if (newUntilDate) {
        const newUntil = Date.parse(`${newUntilDate}T00:00:00Z`);
        isNew = Number.isFinite(newUntil) && now < newUntil + dayMs;
      } else {
        const windowDays = Number(badge.dataset.newWindowDays || '60');
        isNew = now < addedAt + windowDays * dayMs;
      }
    }

    badge.classList.toggle('hidden', !isNew);
  }

  refreshModelNewBadge();
  document.addEventListener('astro:page-load', refreshModelNewBadge);

  function initializeModelVisualToggle() {
    const storageKey = 'jetson-ai-lab:model-visuals';
    document.querySelectorAll<HTMLElement>('[data-model-visual-hero]').forEach((hero) => {
      const button = hero.querySelector<HTMLButtonElement>('[data-model-visual-toggle]');
      const artwork = hero.querySelector<HTMLElement>('[data-model-visual-art]');
      const card = hero.querySelector<HTMLElement>('[data-model-visual-card]');
      const stateLabel = button?.querySelector<HTMLElement>('[data-model-visual-state]');
      const switchTrack = button?.querySelector<HTMLElement>('.model-visual-switch');
      const thumb = button?.querySelector<HTMLElement>('.model-visual-thumb');
      if (!button || !artwork || !card || !stateLabel || !switchTrack || !thumb) return;
      const visualBackground = hero.style.backgroundColor || 'rgb(0, 0, 0)';
      const visualCardOpacity = Number(card.dataset.modelVisualCardOpacity ?? 0.5);

      const applyState = (enabled: boolean) => {
        artwork.hidden = !enabled;
        hero.style.backgroundColor = enabled ? visualBackground : 'rgb(0, 0, 0)';
        card.style.backgroundColor = enabled ? `rgba(0, 0, 0, ${visualCardOpacity})` : 'rgb(31, 41, 55)';
        card.style.boxShadow = enabled ? '' : 'none';
        button.setAttribute('aria-pressed', String(enabled));
        button.setAttribute('aria-label', enabled ? 'Turn model visual off' : 'Show model visual');
        stateLabel.textContent = enabled ? 'On' : 'Off';
        switchTrack.style.backgroundColor = enabled ? 'rgba(118, 185, 0, 0.45)' : 'rgba(255, 255, 255, 0.14)';
        thumb.style.transform = enabled ? 'translateX(14px)' : 'translateX(0)';
      };

      let enabled = true;
      try {
        enabled = localStorage.getItem(storageKey) !== 'off';
      } catch {
        // Storage may be disabled; retain the visible default for this page.
      }
      applyState(enabled);

      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        enabled = button.getAttribute('aria-pressed') !== 'true';
        applyState(enabled);
        try {
          localStorage.setItem(storageKey, enabled ? 'on' : 'off');
        } catch {
          // The toggle still works for the current page when storage is unavailable.
        }
      });
    });
  }

  initializeModelVisualToggle();
  document.addEventListener('astro:page-load', initializeModelVisualToggle);

  // Body content device tabs (inside markdown-rendered sections)
  document.querySelectorAll('.device-tabs').forEach(group => {
    const buttons = group.querySelectorAll('.device-tab');
    const panels = group.querySelectorAll('.device-panel');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        buttons.forEach(b => b.classList.toggle('active', b.getAttribute('data-target') === target));
        panels.forEach(p => {
          if (p.getAttribute('data-panel') === target) {
            p.style.display = '';
          } else {
            p.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style is:global>
  .device-tabs {
    margin: 1.5rem 0;
  }
  .device-tab-bar {
    display: flex;
    gap: 2rem;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 1.5rem;
  }
  .device-tab {

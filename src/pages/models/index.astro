---
import { getCollection } from 'astro:content';
import type { InferenceCategory } from '../../lib/engines';
import Layout from '../../layouts/Layout.astro';
import RunCommand from '../../components/RunCommand.astro';
import ModelPerformanceCharts from '../../components/ModelPerformanceCharts.astro';
import llmBenchmarks from '../../data/benchmarks.json';
import { JETSON_MATRIX_MODULES } from '../../lib/inferenceCommands';
import { oneShotHasRunModalContent } from '../../lib/evalRunModal';
import { getSupportedInferenceEngines, sortEnginesForUi } from '../../lib/modelFrontmatterAdapter';
import { isModelNew, MODEL_NEW_WINDOW_DAYS } from '../../lib/modelFreshness';
import { modalityIcon, modalityLabel } from '../../lib/modelModalities';
import {
  CATALOG_ENGINE_FILTERS,
  catalogEngineUiIdsForModel,
  catalogModuleIdsForModel,
} from '../../lib/catalogModelFilters';

function modelTypeToInferenceCategory(type: string | undefined): InferenceCategory {
  const t = type || 'Other';
  if (t === 'Text' || t === 'Image' || t === 'Audio' || t === 'Multimodal') return t;
  return 'Text';
}

const catalogInputDefinitions = [
  { id: 'text', label: 'Text' },
  { id: 'image', label: 'Image / vision' },
  { id: 'video', label: 'Video' },
  { id: 'audio', label: 'Audio' },
  { id: 'action', label: 'Robot state / action' },
] as const;
const catalogOutputDefinitions = [
  { id: 'text-generation', label: 'Text generation' },
  { id: 'image-generation', label: 'Image generation' },
  { id: 'video-generation', label: 'Video generation' },
  { id: 'speech-generation', label: 'Speech generation' },
  { id: 'audio-generation', label: 'Audio generation' },
  { id: 'speech-recognition', label: 'Speech recognition' },
  { id: 'action-generation', label: 'Action generation / VLA' },
  { id: 'classification', label: 'Classification / decision' },
  { id: 'feature-extraction', label: 'Feature extraction' },
  { id: 'text-ranking', label: 'Text ranking' },
] as const;
const catalogOutputLabels = new Map<string, string>(catalogOutputDefinitions.map((output) => [output.id, output.label]));
const catalogOutputLabel = (output: string) => catalogOutputLabels.get(output) || output;
function inferCatalogInputs(data: {
  tasks?: string[];
  type?: string;
  vision_capable?: boolean;
  modalities?: string[];
  input_modalities?: string[];
}): string[] {
  const inputs = new Set(
    (data.input_modalities?.length ? data.input_modalities : data.modalities || [])
      .map((value) => value.toLowerCase())
  );
  const tasks = new Set(data.tasks || []);
  const type = (data.type || '').toLowerCase();

  if (data.vision_capable) inputs.add('image');
  if (tasks.has('automatic-speech-recognition')) inputs.add('audio');
  if (tasks.has('text-to-speech') || tasks.has('text-to-image') || tasks.has('text-to-video')) inputs.add('text');
  if (inputs.size === 0 && (type === 'text' || type === 'multimodal' || type === 'image')) inputs.add('text');

  return [...inputs].filter((input) => catalogInputDefinitions.some((definition) => definition.id === input));
}

function inferCatalogOutputs(data: {
  tasks?: string[];
  type?: string;
  modalities?: string[];
  output_modalities?: string[];
}): string[] {
  const legacyModalities = new Set((data.modalities || []).map((value) => value.toLowerCase()));
  const modalities = new Set((data.output_modalities || []).map((value) => value.toLowerCase()));
  const tasks = new Set(data.tasks || []);
  const outputs = new Set<string>();
  const type = (data.type || '').toLowerCase();

  if (tasks.has('text-generation')) outputs.add('text-generation');
  if (tasks.has('text-to-image')) outputs.add('image-generation');
  if (tasks.has('text-to-video')) outputs.add('video-generation');
  if (tasks.has('text-to-speech')) outputs.add('speech-generation');
  if (tasks.has('audio-generation')) outputs.add('audio-generation');
  if (tasks.has('automatic-speech-recognition')) outputs.add('speech-recognition');
  if (tasks.has('action-generation')) outputs.add('action-generation');
  if (tasks.has('classification')) outputs.add('classification');
  if (tasks.has('feature-extraction')) outputs.add('feature-extraction');
  if (tasks.has('text-ranking')) outputs.add('text-ranking');

  if (modalities.has('text')) outputs.add('text-generation');
  if (modalities.has('image')) outputs.add('image-generation');
  if (modalities.has('video')) outputs.add('video-generation');
  if (modalities.has('audio')) outputs.add('audio-generation');
  if (modalities.has('data')) outputs.add('classification');
  if (modalities.has('action') || legacyModalities.has('action')) outputs.add('action-generation');

  if (outputs.size === 0) {
    if (type === 'image') outputs.add('image-generation');
    else if (type === 'audio') outputs.add('speech-generation');
    else outputs.add('text-generation');
  }

  return [...outputs];
}

function inferOutputModalities(data: { type?: string; output_modalities?: string[] }): string[] {
  if (data.output_modalities?.length) return data.output_modalities.map((value) => value.toLowerCase());
  if (data.type === 'Image') return ['image'];
  if (data.type === 'Audio') return ['audio'];
  return ['text'];
}

type CatalogModelType = 'llm' | 'vlm' | 'vla';

function inferCatalogModelType(inputs: string[], outputs: string[]): CatalogModelType {
  // Action generation takes precedence because VLAs also commonly accept vision input.
  if (outputs.includes('action-generation')) return 'vla';
  if (inputs.includes('image') || inputs.includes('video')) return 'vlm';
  return 'llm';
}

/** Matrix tabs only — same ids as Serve / Run UI. */
const moduleFilterOptions = JETSON_MATRIX_MODULES.filter((m) => m.showInMatrixUi !== false);

const modelEntries = await getCollection('models');
const collectionModels = modelEntries.map(entry => {
  const engines = getSupportedInferenceEngines(entry.data);
  const category = modelTypeToInferenceCategory(entry.data.type);
  const inputs = inferCatalogInputs(entry.data);
  const outputs = inferCatalogOutputs(entry.data);
  const outputModalities = inferOutputModalities(entry.data);
  const catalogType = inferCatalogModelType(inputs, outputs);
  const catalog_modules = catalogModuleIdsForModel(
    category,
    engines,
    entry.data.matrix_modules_disabled,
    entry.data.one_shot_inference
  );
  const catalog_engine_ui_ids = catalogEngineUiIdsForModel(
    category,
    engines,
    entry.data.matrix_modules_disabled,
    entry.data.one_shot_inference
  );
  const modelIsNew = isModelNew(entry.data);
  return {
    id: entry.slug,
    name: entry.data.title,
    description: entry.data.short_description,
    category: entry.data.type || 'Other',
    family: entry.data.family || 'Other',
    minimumJetson: entry.data.minimum_jetson || 'Orin NX',
    memory: entry.data.memory_requirements,
    size: entry.data.model_size,
    order: entry.data.order ?? 999,
    status: modelIsNew ? 'new' : 'stable',
    highlighted: modelIsNew,
    hasFreshnessMetadata: entry.data.catalog_added_at !== undefined || entry.data.is_new !== undefined,
    catalogAddedAt: entry.data.catalog_added_at,
    newUntil: entry.data.new_until,
    legacyIsNew: entry.data.is_new === true,
    inputs,
    outputs,
    primaryOutput: outputs.includes('action-generation') ? 'action-generation' : outputs[0] || 'text-generation',
    outputModalities,
    catalogType,
    updatedAt: entry.data.updated_at,
    validationStatus: entry.data.validation_status,
    supported_inference_engines: sortEnginesForUi(engines),
    catalog_modules,
    catalog_engine_ui_ids,
    hf_checkpoint: entry.data.hf_checkpoint,
    hideRunButton: entry.data.hide_run_button ?? false,
    matrix_modules_disabled: entry.data.matrix_modules_disabled,
    vision_capable: entry.data.vision_capable,
    one_shot_inference: entry.data.one_shot_inference,
  };
});

// Models come from content collection only, sorted by order within family
const models = collectionModels.sort((a, b) => a.order - b.order);

const familyOrder: Record<string, number> = {
  'Liquid AI d1': -5,
  'Black Forest Labs': -4,
  'Alibaba Qwen3.8': -3,
  'NVIDIA Nemotron': -2,
  'Meta Muse': -1,
  'Alibaba Qwen3.6': 0,
  'Google Gemma4': 1,
  'NVIDIA Cosmos': 3,
  'Alibaba Qwen3.5': 4,
  'OpenAI GPT OSS': 5,
  'Alibaba Qwen3': 6,
  'Mistral AI Ministral 3': 7,
  'Meta Llama 3': 8,
  'Google Gemma3': 9,
};
const families = Array.from(new Set(models.map(m => m.family)))
  .sort((a, b) => (familyOrder[a] ?? 99) - (familyOrder[b] ?? 99));
const inputFilterOptions = catalogInputDefinitions.filter((input) =>
  models.some((model) => model.inputs.includes(input.id))
);
const inputCounts = new Map(
  inputFilterOptions.map((input) => [
    input.id,
    models.filter((model) => model.inputs.includes(input.id)).length,
  ])
);
const outputFilterOptions = catalogOutputDefinitions.filter((output) =>
  models.some((model) => model.outputs.includes(output.id))
);
const outputCounts = new Map(
  outputFilterOptions.map((output) => [
    output.id,
    models.filter((model) => model.outputs.includes(output.id)).length,
  ])
);
const moduleCounts = new Map(
  moduleFilterOptions.map((module) => [
    module.id,
    models.filter((model) => model.catalog_modules.includes(module.id)).length,
  ])
);
const engineCounts = new Map(
  CATALOG_ENGINE_FILTERS.map((engine) => [
    engine.uiId,
    models.filter((model) => model.catalog_engine_ui_ids.includes(engine.uiId)).length,
  ])
);
const newModelCount = models.filter((model) => model.status === 'new').length;
const catalogTypeDefinitions = [
  { id: 'all', label: 'All models', description: 'Every model' },
  { id: 'llm', label: 'LLM', description: 'Text models' },
  { id: 'vlm', label: 'VLM', description: 'Vision models' },
  { id: 'vla', label: 'VLA', description: 'Robot action models' },
] as const;
const catalogTypeCounts = new Map(
  catalogTypeDefinitions.map((type) => [
    type.id,
    type.id === 'all' ? models.length : models.filter((model) => model.catalogType === type.id).length,
  ])
);

---

<Layout title="Models" description="Discover all generative AI models optimized for Jetson">
  <!-- Featured Models -->
  {models.filter(m => m.highlighted).length > 0 && (
    <section class="border-b border-nvidia-gray-200 bg-nvidia-gray-50 py-12" id="featured-models-section">
      <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="relative mb-8 text-center">
          <h2 class="text-2xl font-bold text-nvidia-black">Featured Models</h2>
          <p class="mt-1 text-nvidia-gray-600">Latest releases with day-0 support on Jetson</p>
          <div class="mt-4 flex justify-center gap-1.5 sm:absolute sm:right-0 sm:top-1/2 sm:mt-0 sm:-translate-y-1/2" aria-label="Featured model carousel controls">
            <button
              type="button"
              id="featured-models-previous"
              class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-nvidia-gray-200 bg-white text-nvidia-gray-700 transition-colors hover:border-nvidia-gray-400 hover:text-nvidia-black disabled:cursor-default disabled:opacity-35"
              aria-label="Previous featured models"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />
              </svg>
            </button>
            <button
              type="button"
              id="featured-models-next"
              class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-nvidia-gray-200 bg-white text-nvidia-gray-700 transition-colors hover:border-nvidia-gray-400 hover:text-nvidia-black disabled:cursor-default disabled:opacity-35"
              aria-label="Next featured models"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" />
              </svg>
            </button>
          </div>
        </div>

        <div class="relative -mx-4 px-4 sm:mx-0 sm:px-0">
          <div id="featured-models-track" class="scrollbar-hide flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 scroll-smooth [justify-content:safe_center]">
            {models.filter(m => m.highlighted).map(model => (
              <div
                class="model-catalog-card w-[280px] flex-shrink-0 snap-center sm:w-[300px] md:w-[320px]"
                data-catalog-modules={model.catalog_modules.join(',')}
                data-catalog-engines={model.catalog_engine_ui_ids.join(',')}
                data-name={model.name.toLowerCase()}
                data-search={`${model.name} ${model.family} ${model.description}`.toLowerCase()}
                data-catalog-inputs={model.inputs.join(',')}
                data-catalog-outputs={model.outputs.join(',')}
                data-catalog-type={model.catalogType}
                data-status={model.status}
                data-model-freshness
                data-catalog-added-at={model.catalogAddedAt}
                data-new-until={model.newUntil}
                data-legacy-is-new={String(model.legacyIsNew)}
                data-category={model.category}
              >
                <article class="group flex h-full flex-col overflow-hidden rounded-xl border border-nvidia-gray-200 bg-white shadow-sm transition-all duration-200 hover:border-nvidia-green hover:shadow-lg">
                  <div class="flex h-full flex-col p-6">
                    <div class="mb-4 flex min-w-0 items-center gap-2">
                      <h3 class="min-w-0 flex-1 truncate text-lg font-bold">
                        <a
                          href={`/models/${model.id}`}
                          data-model-link
                          class="text-nvidia-black transition-colors hover:text-nvidia-green hover:underline hover:underline-offset-2"
                        >
                          {model.name}
                        </a>
                      </h3>
                      <span class="shrink-0 rounded bg-nvidia-gray-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-nvidia-gray-700">
                        {model.catalogType.toUpperCase()}
                      </span>
                    </div>

                    <p class="mb-6 h-[4.5rem] overflow-hidden text-sm leading-relaxed text-nvidia-gray-600">
                      {model.description}
                    </p>

                    <div class="mt-auto flex min-h-10 items-center border-t border-nvidia-gray-100 pt-4">
                      {!model.hideRunButton &&
                        (model.supported_inference_engines.length > 0 || oneShotHasRunModalContent(model.one_shot_inference)) && (
                          <RunCommand modelId={model.id} modelName={model.name} category={model.category} forceModal={model.category === 'Image'} supportedEngines={model.supported_inference_engines} hfCheckpoint={model.hf_checkpoint} matrixModulesDisabled={model.matrix_modules_disabled} oneShotInference={model.one_shot_inference} />
                        )}
                    </div>
                  </div>
                </article>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- All Models Directory -->
  <section class="py-10 bg-nvidia-white" id="directory" data-new-window-days={MODEL_NEW_WINDOW_DAYS}>
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6 max-w-3xl">
        <h1 class="text-3xl font-bold text-nvidia-black mb-2">All Models</h1>
        <p class="text-base text-nvidia-gray-600">
          Browse by family cards or switch to a sortable table.
        </p>
      </div>

      <button
        type="button"
        id="models-mobile-filter-toggle"
        class="lg:hidden mb-5 w-full inline-flex items-center justify-center gap-2 rounded-lg border border-nvidia-gray-200 bg-nvidia-gray-50 px-4 py-2.5 text-sm font-semibold text-nvidia-black"
        aria-expanded="false"
        aria-controls="models-filter-panel"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M6 10h12M10 16h4" />
        </svg>
        Filters
        <span id="models-mobile-filter-count" class="hidden min-w-5 rounded-full bg-nvidia-green px-1.5 py-0.5 text-[10px] font-bold text-nvidia-black">0</span>
      </button>

      <div class="flex flex-col gap-6 lg:flex-row">
        <aside id="models-filter-panel" class="hidden lg:block lg:w-80 lg:flex-shrink-0">
          <div class="lg:sticky lg:top-24 rounded-xl border border-nvidia-gray-200 bg-nvidia-gray-50/60 p-5">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-lg font-bold text-nvidia-black">Filters</h3>
              <button type="button" id="models-filter-reset" class="hidden text-xs font-semibold text-nvidia-green hover:underline">
                Clear all
              </button>
            </div>
            <p class="text-xs text-nvidia-gray-500 mb-5">Start with a model type, or switch to advanced capability filters.</p>

            <div class="border-b border-nvidia-gray-200 pb-5 mb-4">
              <div class="mb-3 flex items-center justify-between gap-3">
                <h4 class="text-xs font-bold text-nvidia-gray-500 uppercase tracking-wider">Jetson device</h4>
                <button
                  type="button"
                  data-device-icon-toggle
                  aria-pressed="false"
                  class="group inline-flex items-center gap-1.5 rounded px-1.5 py-1 text-[10px] font-semibold text-nvidia-gray-500 transition-colors hover:text-nvidia-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nvidia-green"
                >
                  Icon
                  <span aria-hidden="true" class="relative inline-flex h-4 w-7 rounded bg-nvidia-gray-300 shadow-inner transition-colors group-aria-pressed:bg-nvidia-green">
                    <span class="absolute left-0.5 top-0.5 h-3 w-3 rounded-sm bg-white shadow-sm transition-transform group-aria-pressed:translate-x-3"></span>
                  </span>
                </button>
              </div>

              <div data-device-compact-filters class="space-y-2.5">
                {moduleFilterOptions.map((module) => (
                  <label class="flex cursor-pointer items-center gap-2 group">
                    <input type="checkbox" value={module.id} data-catalog-module-filter class="rounded border-nvidia-gray-300 text-nvidia-green focus:ring-nvidia-green" />
                    <span data-catalog-filter-label class="min-w-0 flex-1 text-sm text-nvidia-gray-700 group-hover:text-nvidia-black">{module.shortLabel}</span>
                    <span class="text-xs tabular-nums text-nvidia-gray-400">{moduleCounts.get(module.id)}</span>
                  </label>
                ))}
              </div>

              <div data-device-icon-filters class="hidden grid-cols-2 gap-2">
                {moduleFilterOptions.map((module) => (
                  <label class="group relative min-w-0 cursor-pointer">
                    <input type="checkbox" value={module.id} data-catalog-module-filter class="peer sr-only" />
                    <span class="flex min-h-[68px] items-center gap-2 rounded-md border-2 border-nvidia-gray-200 bg-white p-2 transition-colors group-hover:border-nvidia-green peer-focus-visible:ring-2 peer-focus-visible:ring-nvidia-green peer-focus-visible:ring-offset-2 peer-checked:border-nvidia-green peer-checked:bg-nvidia-green/10">
                      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded bg-nvidia-gray-50 p-1">
                        {module.iconSrc ? (
                          <img src={module.iconSrc} alt="" class="h-full w-full object-contain" loading="lazy" />
                        ) : (
                          <svg class="h-5 w-5 text-nvidia-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6v6H9zM9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/></svg>
                        )}
                      </span>
                      <span class="min-w-0 flex-1">
                        <span data-catalog-filter-label class="block text-xs font-bold leading-tight text-nvidia-gray-800">{module.shortLabel}</span>
                        <span class="mt-1 block text-[10px] tabular-nums text-nvidia-gray-400">{moduleCounts.get(module.id)} models</span>
                      </span>
                    </span>
                    <svg class="absolute right-2 top-2 hidden h-3.5 w-3.5 rounded-sm bg-nvidia-green p-0.5 text-nvidia-black peer-checked:block" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 10 3 3 7-7"/></svg>
                  </label>
                ))}
              </div>
            </div>

            <div class="border-b border-nvidia-gray-200 pb-5 mb-4">
              <div class="mb-4 flex rounded-md border border-nvidia-gray-200 bg-nvidia-gray-100 p-0.5" role="group" aria-label="Filter detail">
                <button
                  type="button"
                  data-catalog-filter-mode="simple"
                  aria-pressed="true"
                  class="flex-1 rounded px-2 py-1.5 text-xs font-semibold text-nvidia-gray-600 transition-colors aria-pressed:bg-white aria-pressed:text-nvidia-black aria-pressed:shadow-sm"
                >
                  Simple
                </button>
                <button
                  type="button"
                  data-catalog-filter-mode="advanced"
                  aria-pressed="false"
                  class="flex-1 rounded px-2 py-1.5 text-xs font-semibold text-nvidia-gray-600 transition-colors aria-pressed:bg-white aria-pressed:text-nvidia-black aria-pressed:shadow-sm"
                >
                  Advanced
                </button>
              </div>

              <div data-catalog-simple-filters>
                <h4 class="text-xs font-bold text-nvidia-gray-500 uppercase tracking-wider mb-3">Model type</h4>
                <div class="grid grid-cols-2 gap-2">
                  {catalogTypeDefinitions.map((type) => (
                    <button
                      type="button"
                      data-catalog-type-filter={type.id}
                      aria-pressed={type.id === 'all' ? 'true' : 'false'}
                      class="group flex min-h-[74px] flex-col items-start justify-between rounded-md border-2 border-nvidia-gray-200 bg-white p-2.5 text-left transition-colors hover:border-nvidia-green aria-pressed:border-nvidia-green aria-pressed:bg-nvidia-green/10"
                    >
                      <span class="flex w-full items-start justify-between gap-2">
                        <span class="inline-flex h-7 w-7 items-center justify-center rounded bg-nvidia-gray-100 text-nvidia-gray-700 group-aria-pressed:bg-nvidia-green group-aria-pressed:text-nvidia-black">
                          {type.id === 'all' && (
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                          )}
                          {type.id === 'llm' && (
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16M4 10h16M4 15h10M4 20h7"/></svg>
                          )}
                          {type.id === 'vlm' && (
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                          )}
                          {type.id === 'vla' && (
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 20h6M8 20v-4l4-3 2-5 4 2-2 5-4 2v3M14 8l1-3 4 2-1 3M18 17h3v3h-3z"/></svg>
                          )}
                        </span>
                        <span class="text-[10px] tabular-nums text-nvidia-gray-400">{catalogTypeCounts.get(type.id)}</span>
                      </span>
                      <span>
                        <span class="block text-sm font-bold text-nvidia-black">{type.label}</span>
                        <span class="block text-[10px] leading-tight text-nvidia-gray-500">{type.description}</span>
                      </span>
                    </button>
                  ))}
                </div>

<script>
  const MODELS_DIRECTORY_VIEW_KEY = 'jetson-ai-lab-models-directory-view';
  const MODELS_DEVICE_FILTER_VIEW_KEY = 'jetson-ai-lab-models-device-filter-view';

  const SORT_ATTR: Record<string, string> = {
    name: 'data-sort-name',
    family: 'data-sort-family',
    output: 'data-sort-output',
  };

  function initFeaturedModelsCarousel() {
    const track = document.getElementById('featured-models-track');
    const previous = document.getElementById('featured-models-previous') as HTMLButtonElement | null;
    const next = document.getElementById('featured-models-next') as HTMLButtonElement | null;
    if (!track || !previous || !next || track.dataset.carouselListeners === '1') return;

    track.dataset.carouselListeners = '1';

    const updateControls = () => {
      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= maxScroll - 2;
    };
    const scrollFeaturedModels = (direction: -1 | 1) => {
      track.scrollBy({
        left: direction * Math.max(260, Math.min(track.clientWidth * 0.75, 840)),
        behavior: 'smooth',
      });
    };

    previous.addEventListener('click', () => scrollFeaturedModels(-1));
    next.addEventListener('click', () => scrollFeaturedModels(1));
    track.addEventListener('scroll', updateControls, { passive: true });
    track.addEventListener('featured-models:updated', updateControls);
    window.addEventListener('resize', updateControls);
    requestAnimationFrame(updateControls);
  }

  function initModelDirectoryFilters() {
    const directory = document.getElementById('directory');
    if (!directory) return;

    const noResults = document.getElementById('no-results');
    const cardsSearchBar = document.getElementById('models-search-cards-bar');
    const cardsArea = document.getElementById('models-directory-cards');
    const tableArea = document.getElementById('models-directory-table');
    const tableBody = document.getElementById('models-table-body');
    const btnCards = document.getElementById('models-view-cards');
    const btnCompact = document.getElementById('models-view-compact');
    const btnTable = document.getElementById('models-view-table');
    const filterPanel = document.getElementById('models-filter-panel');
    const mobileFilterToggle = document.getElementById('models-mobile-filter-toggle');
    const mobileFilterCount = document.getElementById('models-mobile-filter-count');
    const filterReset = document.getElementById('models-filter-reset');
    const activeFilters = document.getElementById('models-active-filters');
    const resultCount = document.getElementById('models-result-count');

    let currentSearch = '';
    let catalogFilterMode: 'simple' | 'advanced' = 'simple';

    function setDeviceFilterIconView(iconView: boolean) {
      directory.querySelectorAll<HTMLButtonElement>('[data-device-icon-toggle]').forEach((button) => {
        button.setAttribute('aria-pressed', iconView ? 'true' : 'false');
      });
      directory.querySelectorAll<HTMLElement>('[data-device-compact-filters]').forEach((panel) => {
        panel.classList.toggle('hidden', iconView);
      });
      directory.querySelectorAll<HTMLElement>('[data-device-icon-filters]').forEach((panel) => {
        panel.classList.toggle('hidden', !iconView);
        panel.classList.toggle('grid', iconView);
      });
      try {
        localStorage.setItem(MODELS_DEVICE_FILTER_VIEW_KEY, iconView ? 'icons' : 'compact');
      } catch {
        /* ignore */
      }
    }

    function refreshModelFreshness() {
      const windowDays = Number(directory.dataset.newWindowDays || '60');
      const dayMs = 24 * 60 * 60 * 1000;
      const now = Date.now();

      document.querySelectorAll<HTMLElement>('[data-model-freshness]').forEach((element) => {
        const addedDate = element.dataset.catalogAddedAt;
        const newUntilDate = element.dataset.newUntil;
        let isNew = element.dataset.legacyIsNew === 'true';

        if (addedDate) {
          const addedAt = Date.parse(`${addedDate}T00:00:00Z`);
          if (!Number.isFinite(addedAt) || now < addedAt) {
            isNew = false;
          } else if (newUntilDate) {
            const newUntil = Date.parse(`${newUntilDate}T00:00:00Z`);
            isNew = Number.isFinite(newUntil) && now < newUntil + dayMs;
          } else {
            isNew = now < addedAt + windowDays * dayMs;
          }
        }

        element.dataset.status = isNew ? 'new' : 'stable';
        element.querySelectorAll<HTMLElement>('[data-model-new-badge]').forEach((badge) => {
          badge.classList.toggle('hidden', !isNew);
        });
      });

      const newCount = directory.querySelectorAll('.model-card[data-status="new"]').length;
      directory.querySelectorAll<HTMLElement>('[data-catalog-new-count]').forEach((count) => {
        count.textContent = String(newCount);
      });
      directory.querySelectorAll<HTMLElement>('[data-catalog-new-toggle]').forEach((toggle) => {
        toggle.classList.toggle('hidden', newCount === 0);
      });
    }
    let tableSortCol = '';
    let tableSortDir: 'asc' | 'desc' = 'asc';

    function selectedCatalogModuleIds(): Set<string> {
      const s = new Set<string>();
      directory.querySelectorAll<HTMLInputElement>('[data-catalog-module-filter]').forEach((cb) => {
        if (cb.checked && cb.value) s.add(cb.value);
      });
      return s;
    }

    function selectedCatalogEngineIds(): Set<string> {
      const s = new Set<string>();
      directory.querySelectorAll<HTMLInputElement>('[data-catalog-engine-filter]').forEach((cb) => {
        if (cb.checked && cb.value) s.add(cb.value);
      });
      return s;
    }

    function selectedCatalogInputIds(): Set<string> {
      const s = new Set<string>();
      directory.querySelectorAll<HTMLInputElement>('[data-catalog-input-filter]').forEach((cb) => {
        if (cb.checked && cb.value) s.add(cb.value);
      });
      return s;
    }

    function selectedCatalogOutputIds(): Set<string> {
      const s = new Set<string>();
      directory.querySelectorAll<HTMLInputElement>('[data-catalog-output-filter]').forEach((cb) => {
        if (cb.checked && cb.value) s.add(cb.value);
      });
      return s;
    }

    function selectedCatalogType(): string | null {
      const selected = directory.querySelector<HTMLButtonElement>(
        '[data-catalog-type-filter]:not([data-catalog-type-filter="all"])[aria-pressed="true"]'
      );
      return selected?.dataset.catalogTypeFilter || null;
    }

    function setCatalogType(type: string | null) {
      const selectedType = type || 'all';
      directory.querySelectorAll<HTMLButtonElement>('[data-catalog-type-filter]').forEach((button) => {
        button.setAttribute('aria-pressed', button.dataset.catalogTypeFilter === selectedType ? 'true' : 'false');
      });
    }

    function setCatalogFilterMode(mode: 'simple' | 'advanced', clearOtherMode = false) {
      catalogFilterMode = mode;
      directory.querySelectorAll<HTMLButtonElement>('[data-catalog-filter-mode]').forEach((button) => {
        button.setAttribute('aria-pressed', button.dataset.catalogFilterMode === mode ? 'true' : 'false');
      });
      directory.querySelectorAll<HTMLElement>('[data-catalog-simple-filters]').forEach((panel) => {
        panel.classList.toggle('hidden', mode !== 'simple');
      });
      directory.querySelectorAll<HTMLElement>('[data-catalog-advanced-filters]').forEach((panel) => {
        panel.classList.toggle('hidden', mode !== 'advanced');
      });

      if (!clearOtherMode) return;
      if (mode === 'simple') {
        directory
          .querySelectorAll<HTMLInputElement>('[data-catalog-input-filter], [data-catalog-output-filter]')
          .forEach((input) => { input.checked = false; });
      } else {
        setCatalogType(null);
      }
    }

    function newModelsOnly(): boolean {
      return Array.from(directory.querySelectorAll<HTMLButtonElement>('[data-catalog-new-toggle]')).some(
        (button) => button.getAttribute('aria-pressed') === 'true'
      );
    }

    function setNewModelsOnly(active: boolean) {
      directory.querySelectorAll<HTMLButtonElement>('[data-catalog-new-toggle]').forEach((button) => {
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function rowMatchesFilters(el: Element): boolean {
      const searchText = el.getAttribute('data-search') || el.getAttribute('data-name') || '';
      const matchesSearch = !currentSearch || searchText.includes(currentSearch);
      const selectedType = selectedCatalogType();
      const matchesType = catalogFilterMode !== 'simple' || !selectedType || el.getAttribute('data-catalog-type') === selectedType;
      const matchesInputs = elementMatchesCatalogInputFilter(el);
      const matchesOutputs = elementMatchesCatalogOutputFilter(el);
      const matchesModules = elementMatchesCatalogModuleFilter(el);
      const matchesEngines = elementMatchesCatalogEngineFilter(el);
      const matchesRelease = !newModelsOnly() || el.getAttribute('data-status') === 'new';
      return matchesSearch && matchesType && matchesInputs && matchesOutputs && matchesModules && matchesEngines && matchesRelease;
    }

    function elementMatchesCatalogInputFilter(el: Element): boolean {
      const sel = selectedCatalogInputIds();
      if (sel.size === 0) return true;
      const raw = el.getAttribute('data-catalog-inputs') || '';
      const ids = new Set(
        raw
          .split(',')
          .map((x) => x.trim())
          .filter(Boolean)
      );
      for (const id of sel) {
        if (ids.has(id)) return true;
      }
      return false;
    }

    function elementMatchesCatalogOutputFilter(el: Element): boolean {
      const sel = selectedCatalogOutputIds();
      if (sel.size === 0) return true;
      const raw = el.getAttribute('data-catalog-outputs') || '';
      const ids = new Set(
        raw
          .split(',')
          .map((x) => x.trim())
          .filter(Boolean)
      );
      for (const id of sel) {
        if (ids.has(id)) return true;
      }
      return false;
    }

    function elementMatchesCatalogModuleFilter(el: Element): boolean {
      const sel = selectedCatalogModuleIds();
      if (sel.size === 0) return true;
      const raw = el.getAttribute('data-catalog-modules') || '';
      const ids = new Set(
        raw
          .split(',')
          .map((x) => x.trim())
          .filter(Boolean)
      );
      for (const id of sel) {
        if (ids.has(id)) return true;
      }
      return false;
    }

    function elementMatchesCatalogEngineFilter(el: Element): boolean {
      const sel = selectedCatalogEngineIds();
      if (sel.size === 0) return true;
      const raw = el.getAttribute('data-catalog-engines') || '';
      const ids = new Set(
        raw
          .split(',')
          .map((x) => x.trim())
          .filter(Boolean)
      );
      for (const id of sel) {
        if (ids.has(id)) return true;
      }
      return false;
    }

    function isTableView(): boolean {
      return !!(tableArea && !tableArea.classList.contains('hidden'));
    }

    function setViewMode(mode: 'cards' | 'compact' | 'table') {
      try {
        localStorage.setItem(MODELS_DIRECTORY_VIEW_KEY, mode);
      } catch {
        /* ignore */
      }
      if (cardsArea && tableArea) {
        if (mode === 'table') {
          cardsArea.classList.add('hidden');
          tableArea.classList.remove('hidden');
        } else {
          tableArea.classList.add('hidden');
          cardsArea.classList.remove('hidden');
        }
        cardsArea.dataset.cardLayout = mode === 'compact' ? 'compact' : 'legacy';
      }
      [btnCards, btnCompact, btnTable].forEach((button) => {
        const selected = button?.dataset.view === mode;
        button?.classList.toggle('bg-white', selected);
        button?.classList.toggle('shadow-sm', selected);
        button?.classList.toggle('text-nvidia-black', selected);
        button?.classList.toggle('text-nvidia-gray-600', !selected);
        button?.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      if (cardsSearchBar) {
        cardsSearchBar.classList.toggle('hidden', mode === 'table');
      }
    }

    function updateSortIndicators(activeCol: string, dir: 'asc' | 'desc') {
      directory.querySelectorAll('.models-sort-btn').forEach((btn) => {
        const col = btn.getAttribute('data-sort') || '';
        const ind = btn.querySelector('.models-sort-ind');
        if (!ind) return;
        if (col === activeCol) {
          ind.textContent = dir === 'asc' ? '↑' : '↓';
          btn.setAttribute('aria-sort', dir === 'asc' ? 'ascending' : 'descending');
        } else {
          ind.textContent = '';
          btn.removeAttribute('aria-sort');
        }
      });
    }

    function sortTableByColumn(col: string) {
      if (!tableBody) return;
      const attr = SORT_ATTR[col];
      if (!attr) return;

      if (tableSortCol === col) {
        tableSortDir = tableSortDir === 'asc' ? 'desc' : 'asc';
      } else {
        tableSortCol = col;
        tableSortDir = 'asc';
      }

      const rows = Array.from(tableBody.querySelectorAll<HTMLTableRowElement>('.model-table-row'));
      rows.sort((a, b) => {
        const va = a.getAttribute(attr) || '';
        const vb = b.getAttribute(attr) || '';
        let cmp = va.localeCompare(vb, undefined, { numeric: true, sensitivity: 'base' });
        if (tableSortDir === 'desc') cmp = -cmp;
        return cmp;
      });
      rows.forEach((r) => tableBody.appendChild(r));
      updateSortIndicators(col, tableSortDir);
    }

    function displayLabelForFilter(selector: string, value: string): string {
      const input = Array.from(directory.querySelectorAll<HTMLInputElement>(selector)).find((item) => item.value === value);
      const label = input?.closest('label')?.querySelector('[data-catalog-filter-label]');
      return label?.textContent?.trim() || value;
    }

    function renderActiveFilters() {
      if (!activeFilters) return;
      activeFilters.replaceChildren();

      const filters: Array<{ kind: string; value: string; label: string }> = [];
      const selectedType = selectedCatalogType();
      if (catalogFilterMode === 'simple' && selectedType) {
        filters.push({ kind: 'type', value: selectedType, label: selectedType.toUpperCase() });
      }
      selectedCatalogInputIds().forEach((value) => {
        filters.push({ kind: 'input', value, label: `Input: ${displayLabelForFilter('[data-catalog-input-filter]', value)}` });
      });
      selectedCatalogOutputIds().forEach((value) => {
        filters.push({ kind: 'output', value, label: `Output: ${displayLabelForFilter('[data-catalog-output-filter]', value)}` });
      });
      selectedCatalogModuleIds().forEach((value) => {
        filters.push({ kind: 'module', value, label: displayLabelForFilter('[data-catalog-module-filter]', value) });
      });
      selectedCatalogEngineIds().forEach((value) => {
        filters.push({ kind: 'engine', value, label: displayLabelForFilter('[data-catalog-engine-filter]', value) });
      });
      if (newModelsOnly()) filters.push({ kind: 'new', value: 'new', label: 'New models' });

      for (const filter of filters) {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className =
          'inline-flex shrink-0 items-center gap-1.5 rounded-full border border-nvidia-green/40 bg-nvidia-green/10 px-3 py-1 text-xs font-semibold text-nvidia-gray-800 hover:bg-nvidia-green/20';
        chip.dataset.removeCatalogFilter = filter.kind;
        chip.dataset.filterValue = filter.value;
        chip.textContent = `${filter.label} ×`;
        chip.setAttribute('aria-label', `Remove ${filter.label} filter`);
        activeFilters.appendChild(chip);
      }

      filterReset?.classList.toggle('hidden', filters.length === 0 && !currentSearch);
      mobileFilterCount?.classList.toggle('hidden', filters.length === 0);
      if (mobileFilterCount) mobileFilterCount.textContent = String(filters.length);
    }

    function syncFilterUrl() {
      const url = new URL(window.location.href);
      for (const key of ['task', 'capability', 'mode', 'type', 'input', 'output', 'device', 'runtime', 'new', 'q']) url.searchParams.delete(key);
      if (catalogFilterMode === 'advanced') url.searchParams.set('mode', 'advanced');
      const selectedType = selectedCatalogType();
      if (catalogFilterMode === 'simple' && selectedType) url.searchParams.set('type', selectedType);
      selectedCatalogInputIds().forEach((value) => url.searchParams.append('input', value));
      selectedCatalogOutputIds().forEach((value) => url.searchParams.append('output', value));
      selectedCatalogModuleIds().forEach((value) => url.searchParams.append('device', value));
      selectedCatalogEngineIds().forEach((value) => url.searchParams.append('runtime', value));
      if (newModelsOnly()) url.searchParams.set('new', '1');
      if (currentSearch) url.searchParams.set('q', currentSearch);
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    }

    function setCheckedForFilter(selector: string, value: string, checked: boolean) {
      directory.querySelectorAll<HTMLInputElement>(selector).forEach((input) => {
        if (input.value === value) input.checked = checked;
      });
    }

    function restoreFiltersFromUrl() {
      const params = new URLSearchParams(window.location.search);
      params.getAll('input').forEach((value) => setCheckedForFilter('[data-catalog-input-filter]', value, true));
      params.getAll('output').forEach((value) => setCheckedForFilter('[data-catalog-output-filter]', value, true));
      params.getAll('device').forEach((value) => setCheckedForFilter('[data-catalog-module-filter]', value, true));
      params.getAll('runtime').forEach((value) => setCheckedForFilter('[data-catalog-engine-filter]', value, true));
      const requestedType = params.get('type');
      if (requestedType && ['llm', 'vlm', 'vla'].includes(requestedType)) setCatalogType(requestedType);
      const hasCapabilityFilters = params.has('input') || params.has('output');
      setCatalogFilterMode(params.get('mode') === 'advanced' || hasCapabilityFilters ? 'advanced' : 'simple');
      setNewModelsOnly(params.get('new') === '1');
      const query = params.get('q') || '';
      currentSearch = query.toLowerCase().trim();
      directory.querySelectorAll<HTMLInputElement>('.model-directory-search').forEach((input) => {
        input.value = query;
      });
    }

    function clearAllFilters() {
      directory
        .querySelectorAll<HTMLInputElement>(
          '[data-catalog-input-filter], [data-catalog-output-filter], [data-catalog-module-filter], [data-catalog-engine-filter]'
        )
        .forEach((input) => {
          input.checked = false;
        });
      setCatalogType(null);
      setNewModelsOnly(false);
      currentSearch = '';
      directory.querySelectorAll<HTMLInputElement>('.model-directory-search').forEach((input) => {
        input.value = '';
      });
      filterModels();
    }

    function filterModels() {
      const modelGroups = document.querySelectorAll('.model-family-group');
      let hasVisibleInCards = false;
      let visibleModelCount = 0;

      modelGroups.forEach((group) => {
        const cards = group.querySelectorAll('.model-card');
        let visibleCardsInGroup = 0;

        cards.forEach((card) => {
          const el = card as HTMLElement;
          if (rowMatchesFilters(card)) {
            el.style.display = '';
            visibleCardsInGroup++;
            visibleModelCount++;
            hasVisibleInCards = true;
          } else {
            el.style.display = 'none';
          }
        });

        (group as HTMLElement).style.display = visibleCardsInGroup > 0 ? '' : 'none';
      });

      let hasVisibleInTable = false;
      document.querySelectorAll<HTMLTableRowElement>('.model-table-row').forEach((row) => {
        if (rowMatchesFilters(row)) {
          row.style.display = '';
          hasVisibleInTable = true;
        } else {
          row.style.display = 'none';
        }
      });

      const activeHasModels = isTableView() ? hasVisibleInTable : hasVisibleInCards;
      noResults?.classList.toggle('hidden', activeHasModels);
      if (resultCount) resultCount.textContent = `${visibleModelCount} ${visibleModelCount === 1 ? 'model' : 'models'}`;
      renderActiveFilters();
      syncFilterUrl();
    }

    refreshModelFreshness();

    if (directory.dataset.modelsFilterListeners !== '1') {
      directory.dataset.modelsFilterListeners = '1';

      let initial: 'cards' | 'compact' | 'table' = 'cards';
      try {
        const v = localStorage.getItem(MODELS_DIRECTORY_VIEW_KEY);
        if (v === 'table' || v === 'compact' || v === 'cards') initial = v;
      } catch {
        /* ignore */
      }
      let deviceIconView = false;
      try {
        deviceIconView = localStorage.getItem(MODELS_DEVICE_FILTER_VIEW_KEY) === 'icons';
      } catch {
        /* ignore */
      }
      setDeviceFilterIconView(deviceIconView);
      restoreFiltersFromUrl();
      setViewMode(initial);

      directory.querySelectorAll<HTMLInputElement>('.model-directory-search').forEach((input) => {
        input.addEventListener('input', () => {
          const v = input.value;
          currentSearch = v.toLowerCase().trim();
          directory.querySelectorAll<HTMLInputElement>('.model-directory-search').forEach((other) => {
            if (other !== input) other.value = v;
          });
          filterModels();
        });
      });

      btnCards?.addEventListener('click', () => {
        setViewMode('cards');
        filterModels();
      });
      btnCompact?.addEventListener('click', () => {
        setViewMode('compact');
        filterModels();
      });
      btnTable?.addEventListener('click', () => {
        setViewMode('table');
        filterModels();
      });
      directory.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement | null;
        if (t?.matches?.('[data-catalog-input-filter]')) {
          const v = t.value;
          directory.querySelectorAll<HTMLInputElement>('[data-catalog-input-filter]').forEach((cb) => {
            if (cb.value === v) cb.checked = t.checked;
          });
        } else if (t?.matches?.('[data-catalog-output-filter]')) {
          const v = t.value;
          directory.querySelectorAll<HTMLInputElement>('[data-catalog-output-filter]').forEach((cb) => {
            if (cb.value === v) cb.checked = t.checked;
          });
        } else if (t?.matches?.('[data-catalog-module-filter]')) {
          const v = t.value;
          directory.querySelectorAll<HTMLInputElement>('[data-catalog-module-filter]').forEach((cb) => {
            if (cb.value === v) cb.checked = t.checked;
          });
        } else if (t?.matches?.('[data-catalog-engine-filter]')) {
          const v = t.value;
          directory.querySelectorAll<HTMLInputElement>('[data-catalog-engine-filter]').forEach((cb) => {
            if (cb.value === v) cb.checked = t.checked;
          });
        }
        if (t?.matches?.('[data-catalog-input-filter], [data-catalog-output-filter], [data-catalog-module-filter], [data-catalog-engine-filter]')) {
          filterModels();
        }
      });
      directory.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const deviceIconToggle = target?.closest<HTMLButtonElement>('[data-device-icon-toggle]');
        if (deviceIconToggle) {
          setDeviceFilterIconView(deviceIconToggle.getAttribute('aria-pressed') !== 'true');
          return;
        }
        const modeButton = target?.closest<HTMLButtonElement>('[data-catalog-filter-mode]');
        if (modeButton) {
          const mode = modeButton.dataset.catalogFilterMode === 'advanced' ? 'advanced' : 'simple';
          if (mode !== catalogFilterMode) {
            setCatalogFilterMode(mode, true);
            filterModels();
          }
          return;
        }
        const typeButton = target?.closest<HTMLButtonElement>('[data-catalog-type-filter]');
        if (typeButton) {
          setCatalogType(typeButton.dataset.catalogTypeFilter === 'all' ? null : typeButton.dataset.catalogTypeFilter || null);
          filterModels();
          return;
        }
        const newToggle = target?.closest<HTMLButtonElement>('[data-catalog-new-toggle]');
        if (newToggle) {
          setNewModelsOnly(!newModelsOnly());
          filterModels();
          return;
        }
        const chip = target?.closest<HTMLButtonElement>('[data-remove-catalog-filter]');
        if (chip) {
          const kind = chip.dataset.removeCatalogFilter;
          const value = chip.dataset.filterValue || '';
          const selectors: Record<string, string> = {
            input: '[data-catalog-input-filter]',
            output: '[data-catalog-output-filter]',
            module: '[data-catalog-module-filter]',
            engine: '[data-catalog-engine-filter]',
          };
          const selector = kind ? selectors[kind] : '';
          if (kind === 'new') setNewModelsOnly(false);
          else if (kind === 'type') setCatalogType(null);
          else if (selector) setCheckedForFilter(selector, value, false);
          filterModels();
          return;
        }
        if (target?.closest('[data-clear-model-filters]')) clearAllFilters();
      });
      filterReset?.addEventListener('click', clearAllFilters);
      mobileFilterToggle?.addEventListener('click', () => {
        const isOpen = mobileFilterToggle.getAttribute('aria-expanded') === 'true';
        mobileFilterToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        filterPanel?.classList.toggle('hidden', isOpen);
      });
      directory.querySelectorAll('.models-sort-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const col = btn.getAttribute('data-sort');
          if (col) sortTableByColumn(col);
        });
      });
    }

    filterModels();
  }

  function initModelsPage() {
    initFeaturedModelsCarousel();
    initModelDirectoryFilters();
  }

  document.addEventListener('DOMContentLoaded', initModelsPage);
  document.addEventListener('astro:page-load', initModelsPage);
</script>


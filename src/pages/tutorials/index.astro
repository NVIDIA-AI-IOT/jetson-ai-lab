---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import TutorialSection from '../../components/TutorialSection.astro';
import TutorialCard from '../../components/TutorialCard.astro';
import categoryConfig from '../../data/categories.json';

const allTutorials = await getCollection('tutorials');
const featuredTutorials = allTutorials.filter(t => t.data.featured);

// Group tutorials by category
const tutorialsByCategory = allTutorials.reduce((acc, tutorial) => {
  const cat = tutorial.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(tutorial);
  return acc;
}, {} as Record<string, typeof allTutorials>);

// Get categories that have tutorials, sorted by order
const activeCategories = Object.keys(tutorialsByCategory)
  .filter(cat => tutorialsByCategory[cat].length > 0)
  .sort((a, b) => (categoryConfig[a]?.order || 99) - (categoryConfig[b]?.order || 99));

const categorySlug = (category: string) =>
  category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const tutorialSearchIndex = allTutorials.map((tutorial) => ({
  title: tutorial.data.title,
  description: tutorial.data.description,
  category: tutorial.data.category,
  section: tutorial.data.section || '',
  tags: tutorial.data.tags,
  model: tutorial.data.model || '',
  authors: (tutorial.data.authors || []).map((author) => author.name),
  href: '/tutorials/' + (tutorial.slug.includes('/') ? tutorial.slug.split('/').pop() : tutorial.slug),
}));
---

<Layout title="Tutorials - Jetson AI Lab" description="Master Generative AI on NVIDIA Jetson with our step-by-step guides and tutorials.">
  <!-- Hero Section -->
  <section class="relative bg-nvidia-black text-white py-24 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-nvidia-green/20 rounded-full blur-3xl"></div>
      <div class="absolute top-20 -left-20 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl"></div>
    </div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-6">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-nvidia-white to-nvidia-gray-300">
          Tutorials
        </span>
      </h1>
      <p class="text-xl text-nvidia-gray-300 max-w-2xl mx-auto leading-relaxed">
        Step-by-step guides to deploy, experiment, and run cutting-edge AI models on NVIDIA Jetson devices.
      </p>
      
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#all-tutorials" class="px-6 py-3 bg-nvidia-green text-nvidia-black font-bold rounded-lg hover:bg-nvidia-green/90 transition-all">
          Browse All
        </a>
        <a href="https://github.com/dusty-nv/jetson-containers" target="_blank" rel="noopener" class="px-6 py-3 bg-white/10 backdrop-blur-sm text-white font-semibold rounded-lg hover:bg-white/20 transition-all border border-white/10">
          Jetson Containers
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Tutorials Section -->
  {featuredTutorials.length > 0 && (
    <section class="py-12 bg-nvidia-gray-50 border-b border-nvidia-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="relative -mx-4 px-4 sm:mx-0 sm:px-0">
          <div id="featured-carousel" class="flex gap-6 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide justify-center">
            {featuredTutorials.map(tutorial => (
              <div class="w-[280px] sm:w-[300px] md:w-[320px] snap-center flex-shrink-0">
                <TutorialCard tutorial={tutorial} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Main Content -->
  <section id="all-tutorials" class="py-12 bg-nvidia-white min-h-screen scroll-mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 rounded-2xl border border-nvidia-gray-200 bg-nvidia-gray-50 p-4 sm:p-6">
        <label for="tutorial-search" class="mb-3 block font-bold text-nvidia-black">Search tutorials</label>
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-nvidia-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            id="tutorial-search"
            type="search"
            placeholder="Search tutorials"
            autocomplete="off"
            role="combobox"
            aria-autocomplete="list"
            aria-controls="search-results"
            aria-expanded="false"
            class="w-full rounded-xl border border-nvidia-gray-300 bg-white py-4 pl-12 pr-12 text-base text-nvidia-black shadow-sm outline-none transition-all placeholder:text-nvidia-gray-400 focus:border-transparent focus:ring-2 focus:ring-nvidia-green"
          />
          <button id="search-reset" type="button" class="absolute right-3 top-1/2 hidden -translate-y-1/2 rounded-md px-2 py-1 text-sm font-semibold text-nvidia-gray-500 hover:bg-nvidia-gray-100 hover:text-nvidia-black" aria-label="Clear tutorial search">
            Clear
          </button>
        </div>
        <div id="search-status" class="mt-3 hidden text-sm text-nvidia-gray-600" aria-live="polite"></div>
        <div id="search-results" class="mt-3 hidden max-h-[36rem] overflow-y-auto rounded-xl border border-nvidia-gray-200 bg-white shadow-lg" role="listbox" aria-label="Tutorial search results"></div>
      </div>

      <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Sidebar Navigation -->
        <aside class="lg:w-64 flex-shrink-0">
          <div class="lg:sticky lg:top-24">
            <!-- Category Quick Links -->
            <nav class="bg-nvidia-gray-50 rounded-xl border border-nvidia-gray-200 overflow-hidden">
              <div class="px-4 py-3 bg-nvidia-gray-100 border-b border-nvidia-gray-200">
                <h3 class="font-semibold text-nvidia-black text-sm">Jump to Section</h3>
              </div>
              <div class="p-2">
                {activeCategories.map(cat => (
                  <a 
                    href={`#section-${categorySlug(cat)}`}
                    class="nav-link flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-nvidia-gray-100 transition-colors group"
                    data-category={cat}
                  >
                    <span class="text-lg">{categoryConfig[cat]?.icon || '📄'}</span>
                    <div class="flex-1">
                      <div class="text-sm font-medium text-nvidia-black group-hover:text-nvidia-green transition-colors">
                        {categoryConfig[cat]?.title || cat}
                      </div>
                      <div class="text-xs text-nvidia-gray-500">
                        {tutorialsByCategory[cat].length} tutorials
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </nav>
            
            <!-- Resources -->
            <div class="mt-6 bg-nvidia-green/5 rounded-xl p-4 border border-nvidia-green/20">
              <h3 class="font-semibold text-nvidia-black text-sm mb-3">Resources</h3>
              <div class="space-y-2">
                <a 
                  href="https://github.com/dusty-nv/jetson-containers" 
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-2 text-sm text-nvidia-gray-600 hover:text-nvidia-green transition-colors"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  Jetson Containers
                </a>
                <a 
                  href="/models" 
                  class="flex items-center gap-2 text-sm text-nvidia-gray-600 hover:text-nvidia-green transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                  </svg>
                  Supported Models
                </a>
              </div>
            </div>
          </div>
        </aside>
        
        <!-- Tutorial Sections -->
        <main class="flex-1 min-w-0">
          <div class="space-y-4" id="tutorial-sections">
            {activeCategories.map((cat, index) => (
              <div id={`section-${categorySlug(cat)}`} class="scroll-mt-24">
                <TutorialSection 
                  title={categoryConfig[cat]?.title || cat}
                  icon={categoryConfig[cat]?.icon || '📄'}
                  tutorials={tutorialsByCategory[cat]}
                  sectionId={categorySlug(cat)}
                  colorClass={categoryConfig[cat]?.colorClass || 'bg-nvidia-gray-100 text-nvidia-gray-600'}
                  defaultOpen={index === 0}
                />
              </div>
            ))}
          </div>
          
          <!-- Empty State (for search) -->
          <div id="no-results" class="hidden py-16 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-nvidia-gray-100 mb-4">
              <svg class="w-8 h-8 text-nvidia-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-nvidia-black">No tutorials found</h3>
            <p class="text-nvidia-gray-600 mt-1">Try a different search term</p>
            <button id="clear-search" class="mt-4 text-nvidia-green font-semibold hover:underline">
              Clear search
            </button>
          </div>
        </main>
      </div>
    </div>
  </section>

<script id="tutorial-search-index" type="application/json" set:html={JSON.stringify(tutorialSearchIndex)}></script>

<script is:inline>
  (() => {
    const searchInput = document.getElementById('tutorial-search');
    const searchResults = document.getElementById('search-results');
    const searchStatus = document.getElementById('search-status');
    const searchReset = document.getElementById('search-reset');
    const searchIndex = document.getElementById('tutorial-search-index');
    const sections = document.getElementById('tutorial-sections');
    const noResults = document.getElementById('no-results');
    const clearBtn = document.getElementById('clear-search');
    const sidebar = document.querySelector('#all-tutorials aside');
    const tutorials = JSON.parse(searchIndex?.textContent || '[]');
    const aliases = {
      llm: ['language model', 'text generation'],
      vlm: ['vision language', 'multimodal', 'vision'],
      vla: ['vision language action', 'robotics'],
      setup: ['install', 'installation', 'getting started'],
      install: ['setup', 'getting started'],
      finetune: ['fine tune', 'fine tuning', 'training'],
      camera: ['vision', 'video'],
      agent: ['coding agent', 'codex', 'cursor', 'claude', 'skills'],
      optimize: ['optimization', 'performance', 'memory'],
      benchmark: ['performance', 'latency', 'throughput'],
    };

    const normalize = (value) => String(value || '')
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

    const editDistance = (left, right) => {
      if (left === right) return 0;
      if (!left.length) return right.length;
      if (!right.length) return left.length;
      let previous = Array.from({ length: right.length + 1 }, (_, index) => index);
      for (let i = 1; i <= left.length; i += 1) {
        const current = [i];
        for (let j = 1; j <= right.length; j += 1) {
          current[j] = Math.min(
            current[j - 1] + 1,
            previous[j] + 1,
            previous[j - 1] + (left[i - 1] === right[j - 1] ? 0 : 1),
          );
        }
        previous = current;
      }
      return previous[right.length];
    };

    const termScore = (term, value, weight) => {
      const text = normalize(value);
      if (!text) return 0;
      if (text === term) return weight * 1.5;
      if (text.startsWith(term)) return weight * 1.25;
      if (text.includes(term)) return weight;
      const words = text.split(' ');
      let best = 0;
      for (const word of words) {
        if (word.startsWith(term) || term.startsWith(word)) best = Math.max(best, weight * .8);
        if (term.length >= 4 && word.length >= 4) {
          const similarity = 1 - editDistance(term, word) / Math.max(term.length, word.length);
          if (similarity >= .72) best = Math.max(best, weight * similarity * .75);
        }
      }
      return best;
    };

    const scoreTutorial = (tutorial, rawQuery) => {
      const query = normalize(rawQuery);
      const terms = [...new Set(query.split(' ').filter(Boolean))];
      if (!terms.length) return 0;
      const title = normalize(tutorial.title);
      const description = normalize(tutorial.description);
      let score = title.includes(query) ? 120 : 0;
      if (description.includes(query)) score += 25;
      let matchedTerms = 0;

      for (const term of terms) {
        const alternatives = [term, ...(aliases[term] || [])];
        let best = 0;
        alternatives.forEach((alternative, index) => {
          const normalizedAlternative = normalize(alternative);
          const aliasFactor = index === 0 ? 1 : .72;
          best = Math.max(
            best,
            termScore(normalizedAlternative, tutorial.title, 45) * aliasFactor,
            termScore(normalizedAlternative, tutorial.model, 42) * aliasFactor,
            termScore(normalizedAlternative, tutorial.tags.join(' '), 36) * aliasFactor,
            termScore(normalizedAlternative, tutorial.section, 24) * aliasFactor,
            termScore(normalizedAlternative, tutorial.category, 20) * aliasFactor,
            termScore(normalizedAlternative, tutorial.description, 12) * aliasFactor,
            termScore(normalizedAlternative, tutorial.authors.join(' '), 10) * aliasFactor,
          );
        });
        if (best > 0) {
          matchedTerms += 1;
          score += best;
        }
      }

      const minimumMatches = terms.length <= 2 ? terms.length : Math.ceil(terms.length * .67);
      return matchedTerms >= minimumMatches ? score + matchedTerms * 5 : 0;
    };

    const makeResult = (tutorial, index) => {
      const link = document.createElement('a');
      link.href = tutorial.href;
      link.id = `tutorial-result-${index}`;
      link.setAttribute('role', 'option');
      link.setAttribute('aria-selected', 'false');
      link.className = 'tutorial-search-result flex items-center gap-4 border-b border-nvidia-gray-100 p-4 transition-colors last:border-0 hover:bg-nvidia-gray-50 focus:bg-nvidia-green/5 focus:outline-none';

      const content = document.createElement('div');
      content.className = 'min-w-0 flex-1';
      const meta = document.createElement('div');
      meta.className = 'mb-1 flex flex-wrap items-center gap-2';
      const category = document.createElement('span');
      category.className = 'rounded-full bg-nvidia-green/10 px-2 py-0.5 text-xs font-semibold text-green-800';
      category.textContent = tutorial.category;
      meta.appendChild(category);
      if (tutorial.section) {
        const section = document.createElement('span');
        section.className = 'text-xs text-nvidia-gray-500';
        section.textContent = tutorial.section;
        meta.appendChild(section);
      }
      const title = document.createElement('div');
      title.className = 'truncate font-bold text-nvidia-black';
      title.textContent = tutorial.title;
      const description = document.createElement('div');
      description.className = 'mt-1 truncate text-sm text-nvidia-gray-600';
      description.textContent = tutorial.description;
      content.append(meta, title, description);

      const arrow = document.createElement('span');
      arrow.className = 'flex-shrink-0 text-xl font-bold text-nvidia-green';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '→';
      link.append(content, arrow);
      return link;
    };

    let activeResult = -1;
    let searchTimeout;

    const resetSearch = () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.setAttribute('aria-expanded', 'false');
        searchInput.removeAttribute('aria-activedescendant');
      }
      searchReset?.classList.add('hidden');
      searchStatus?.classList.add('hidden');
      searchResults?.classList.add('hidden');
      searchResults?.replaceChildren();
      sections?.classList.remove('hidden');
      sidebar?.classList.remove('hidden');
      noResults?.classList.add('hidden');
      activeResult = -1;
    };

    const setActiveResult = (next) => {
      const results = [...document.querySelectorAll('.tutorial-search-result')];
      if (!results.length) return;
      activeResult = (next + results.length) % results.length;
      results.forEach((result, index) => result.setAttribute('aria-selected', index === activeResult ? 'true' : 'false'));
      const active = results[activeResult];
      searchInput?.setAttribute('aria-activedescendant', active.id);
      active.scrollIntoView({ block: 'nearest' });
    };

    searchInput?.addEventListener('input', (event) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        const query = event.target.value.trim();
        if (!query) return resetSearch();
        const matches = tutorials
          .map((tutorial) => ({ tutorial, score: scoreTutorial(tutorial, query) }))
          .filter((result) => result.score > 0)
          .sort((left, right) => right.score - left.score || left.tutorial.title.localeCompare(right.tutorial.title))
          .slice(0, 12);

        searchReset?.classList.remove('hidden');
        sections?.classList.add('hidden');
        sidebar?.classList.add('hidden');
        searchResults?.replaceChildren();
        activeResult = -1;
        if (matches.length === 0) {
          searchResults?.classList.add('hidden');
          noResults?.classList.remove('hidden');
          searchStatus.textContent = `No tutorials found for “${query}”`;
          searchStatus?.classList.remove('hidden');
          searchInput.setAttribute('aria-expanded', 'false');
        } else {
          noResults?.classList.add('hidden');
          searchResults?.classList.remove('hidden');
          matches.forEach(({ tutorial }, index) => searchResults.appendChild(makeResult(tutorial, index)));
          searchStatus.textContent = `${matches.length} best ${matches.length === 1 ? 'match' : 'matches'} for “${query}”`;
          searchStatus?.classList.remove('hidden');
          searchInput.setAttribute('aria-expanded', 'true');
        }
      }, 120);
    });

    searchInput?.addEventListener('keydown', (event) => {
      const results = [...document.querySelectorAll('.tutorial-search-result')];
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActiveResult(activeResult + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActiveResult(activeResult - 1);
      } else if (event.key === 'Enter' && activeResult >= 0 && results[activeResult]) {
        event.preventDefault();
        results[activeResult].click();
      } else if (event.key === 'Escape') {
        resetSearch();
      }
    });

    [clearBtn, searchReset].forEach((button) => button?.addEventListener('click', () => {
      resetSearch();
      searchInput?.focus();
    }));
    
    const expandTutorialSection = (target) => {
      const header = target.querySelector('.section-header');
      const content = target.querySelector('.section-content');
      if (!header || !content || header.getAttribute('aria-expanded') === 'true') return;

      header.setAttribute('aria-expanded', 'true');
      content.classList.add('expanded');
      content.style.maxHeight = `${content.scrollHeight}px`;
    };

    // Smooth scroll for nav links
    document.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href?.startsWith('#')) {
          e.preventDefault();
          const target = document.getElementById(decodeURIComponent(href.slice(1)));
          if (target) {
            expandTutorialSection(target);
            history.replaceState(null, '', href);
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    const openSectionFromHash = (smooth = false) => {
      if (!window.location.hash) return;
      const id = decodeURIComponent(window.location.hash.slice(1));
      const normalizedId = id.toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-|-$/g, '');
      const target = document.getElementById(id) || document.getElementById(normalizedId);
      if (!target) return;
      expandTutorialSection(target);
      window.requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
      });
    };

    openSectionFromHash();
    window.addEventListener('hashchange', () => openSectionFromHash(true));
    
    // Highlight active section on scroll
    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -70% 0px',
      threshold: 0
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const id = entry.target.id;
        const navLink = document.querySelector(`.nav-link[href="#${id}"]`);
        
        if (entry.isIntersecting) {
          document.querySelectorAll('.nav-link').forEach(link => {
            link.classList.remove('bg-nvidia-green/10');
            link.querySelector('.font-medium')?.classList.remove('text-nvidia-green');
          });
          navLink?.classList.add('bg-nvidia-green/10');
          navLink?.querySelector('.font-medium')?.classList.add('text-nvidia-green');
        }
      });
    }, observerOptions);
    
    document.querySelectorAll('[id^="section-"]').forEach(section => {
      observer.observe(section);
    });
    
    // Carousel Logic for Featured Tutorials
    const track = document.getElementById('featured-carousel');
    const prev = document.getElementById('featured-prev');
    const next = document.getElementById('featured-next');
    
    if (track && prev && next) {
      prev.addEventListener('click', () => {
        track.scrollBy({ left: -340, behavior: 'smooth' });
      });
      next.addEventListener('click', () => {
        track.scrollBy({ left: 340, behavior: 'smooth' });
      });
    }
  })();
</script>

<style>
  /* Custom scrollbar for search results */
  #search-results::-webkit-scrollbar {
    width: 6px;
  }
  
  #search-results::-webkit-scrollbar-track {
    background: #f3f3f3;
  }
  
  #search-results::-webkit-scrollbar-thumb {
    background: #d1d1d1;
    border-radius: 3px;
  }
  
  #search-results::-webkit-scrollbar-thumb:hover {
    background: #b4b4b4;
  }

  .tutorial-search-result[aria-selected="true"] {
    background: rgba(118, 185, 0, 0.08);
    box-shadow: inset 3px 0 #76b900;
  }
  
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-hide {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
</Layout>

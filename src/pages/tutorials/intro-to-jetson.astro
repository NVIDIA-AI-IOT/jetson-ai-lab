---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Introduction to NVIDIA Jetson"
  description="Introduction to the NVIDIA Jetson platform: generations (Thor, Orin), series, developer kits, production modules, JetPack 7.2 on Jetson Linux, and how Jetson Thor compares to NVIDIA DGX Spark."
>
  <!-- =========================================================
       HERO
       ========================================================= -->
  <section class="relative bg-gradient-to-br from-slate-900 via-emerald-950 to-slate-900 text-white py-20 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute top-1/4 -right-20 w-96 h-96 bg-nvidia-green/30 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-1/4 -left-20 w-80 h-80 bg-nvidia-green/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-nvidia-green/10 rounded-full blur-3xl"></div>
    </div>

    <div class="absolute inset-0 opacity-15" style="background-image: linear-gradient(rgba(118,185,0,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(118,185,0,0.15) 1px, transparent 1px); background-size: 50px 50px;"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        <div class="flex-1 text-center lg:text-left">
          <div class="flex items-center gap-4 mb-6 text-sm font-medium text-nvidia-green justify-center lg:justify-start">
            <a href="/tutorials" class="hover:text-white transition-colors flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              Back to Tutorials
            </a>
          </div>

          <div class="inline-flex items-center gap-3 bg-nvidia-green/20 backdrop-blur-sm border border-nvidia-green/40 rounded-full px-5 py-2 mb-8">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-nvidia-green opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-nvidia-green"></span>
            </span>
            <span class="text-sm font-semibold text-nvidia-green tracking-wider uppercase">Introduction to Jetson</span>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-8">
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-nvidia-green to-white">
              NVIDIA Jetson
            </span>
            <br />
            <span class="text-white">The Platform for Physical AI</span>
          </h1>

          <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
            <a href="#developer-kits" class="px-6 py-3 bg-nvidia-green text-nvidia-black font-bold rounded-lg hover:bg-nvidia-green/90 transition-all">
              Explore Developer Kits
            </a>
            <a href="#software" class="px-6 py-3 bg-white/10 backdrop-blur-sm text-white font-semibold rounded-lg hover:bg-white/20 transition-all border border-white/10">
              Software Stack
            </a>
            <a href="https://www.nvidia.com/en-in/autonomous-machines/embedded-systems/" target="_blank" rel="noopener" class="px-6 py-3 bg-white/10 backdrop-blur-sm text-white font-semibold rounded-lg hover:bg-white/20 transition-all border border-white/10">
              Product Page
            </a>
          </div>
        </div>

        <div class="flex-1 flex justify-center lg:justify-end">
          <img
            src="/images/hero/jetson-family-line_50pcnt.png"
            alt="NVIDIA Jetson family of developer kits and modules"
            class="w-full max-w-md lg:max-w-lg drop-shadow-2xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       SECTION NAV (anchor jumps)
       ========================================================= -->
  <nav aria-label="On-page sections" class="sticky top-16 z-30 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="flex flex-wrap items-center gap-x-1 gap-y-1 py-2 text-xs sm:text-sm">
        <li><a href="#overview" class="px-3 py-1.5 rounded-full text-slate-600 hover:text-nvidia-green hover:bg-nvidia-green/10 font-medium transition-colors">Overview</a></li>
        <li><a href="#software" class="px-3 py-1.5 rounded-full text-slate-600 hover:text-nvidia-green hover:bg-nvidia-green/10 font-medium transition-colors">Software Stack</a></li>
        <li><a href="#devkits-vs-modules" class="px-3 py-1.5 rounded-full text-slate-600 hover:text-nvidia-green hover:bg-nvidia-green/10 font-medium transition-colors">Devkits vs Modules</a></li>
        <li><a href="#developer-kits" class="px-3 py-1.5 rounded-full text-slate-600 hover:text-nvidia-green hover:bg-nvidia-green/10 font-medium transition-colors">Developer Kits</a></li>
        <li><a href="#modules" class="px-3 py-1.5 rounded-full text-slate-600 hover:text-nvidia-green hover:bg-nvidia-green/10 font-medium transition-colors">Production Modules</a></li>
        <li><a href="#thor-vs-spark" class="px-3 py-1.5 rounded-full text-slate-600 hover:text-nvidia-green hover:bg-nvidia-green/10 font-medium transition-colors">Thor vs DGX Spark</a></li>
        <li><a href="#igx" class="px-3 py-1.5 rounded-full text-slate-600 hover:text-nvidia-green hover:bg-nvidia-green/10 font-medium transition-colors">What About IGX?</a></li>
        <li><a href="#next-steps" class="px-3 py-1.5 rounded-full text-slate-600 hover:text-nvidia-green hover:bg-nvidia-green/10 font-medium transition-colors">Next Steps</a></li>
      </ul>
    </div>
  </nav>

  <!-- =========================================================
       WHAT IS JETSON?
       ========================================================= -->
  <section id="overview" class="py-20 bg-white border-b border-slate-200 scroll-mt-32">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-sm font-semibold text-nvidia-green uppercase tracking-wider">Overview</span>
        <p class="text-lg text-slate-600 max-w-5xl mx-auto leading-relaxed mt-4">
          <span class="block lg:whitespace-nowrap">NVIDIA Jetson™ is a powerful platform for developing innovative edge AI and robotics solutions across industries.</span>
          <span class="block max-w-4xl mx-auto">It delivers the compact, energy-efficient modules and developer kits with a robust AI software stack you need to deploy next-generation physical AI solutions.</span>
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-10">
        <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
          <div class="w-12 h-12 bg-nvidia-green/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-nvidia-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Physical AI Platform</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            NVIDIA Jetson brings accelerated AI compute to the edge for robotics, autonomous machines, industrial systems, cameras, and other embedded applications.
          </p>
        </div>

        <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
          <div class="w-12 h-12 bg-nvidia-green/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-nvidia-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Unified Software</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            JetPack provides a common software foundation across Jetson platforms, including Jetson Linux, CUDA, TensorRT, multimedia APIs, and developer tools.
          </p>
        </div>

        <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
          <div class="w-12 h-12 bg-nvidia-green/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-nvidia-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">From Devkit to Production</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Start development on a Jetson developer kit, then move to a production Jetson module integrated with the carrier board and enclosure for your product.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- =========================================================
       SOFTWARE STACK: Jetson Linux r39
       ========================================================= -->
  <section id="software" class="py-16 bg-slate-900 border-y border-slate-800 scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-sm font-semibold text-nvidia-green uppercase tracking-wider">Software</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-2 mb-3">Software Stack</h2>
      </div>

      <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl border border-slate-700 p-8 md:p-10">
        <div class="space-y-8">
          <div class="space-y-5 text-base text-slate-300 leading-relaxed">
            <p>
              <strong class="text-white">Jetson Linux, formerly Linux for Tegra (L4T),</strong> is NVIDIA's official board support package for Jetson, comprising the kernel, UEFI bootloader, NVIDIA drivers, flashing tools, and an Ubuntu-based root filesystem. Use this path for developer kits, reference platforms, and production software built directly on the NVIDIA-supported BSP.
            </p>
            <p>
              <strong class="text-white">JetPack SDK</strong> packages Jetson Linux with CUDA, cuDNN, TensorRT, multimedia APIs, developer tools, and sample applications. JetPack 7.2 is the SDK release built on Jetson Linux r39.
            </p>
          </div>

          <div class="bg-nvidia-green/10 border border-nvidia-green/30 rounded-xl p-6 space-y-3">
            <p class="text-base text-slate-200 leading-relaxed">
              <strong class="text-nvidia-green">One software foundation across generations.</strong> JetPack 7.2 extends the <strong class="text-white">Ubuntu 24.04</strong>, <strong class="text-white">Linux kernel 6.8</strong>, and <strong class="text-white">NVIDIA CUDA 13</strong> compute stack introduced with Jetson Thor to the Jetson Orin family, bringing both platforms onto a single unified software foundation.
            </p>
            <p class="text-base text-slate-200 leading-relaxed">
              <strong class="text-nvidia-green">Agentic-ready for real-world deployment.</strong> With optimized memory and performance, JetPack 7.2 adds one-command deployment of <strong class="text-white">NVIDIA NemoClaw</strong> and introduces <strong class="text-white">Jetson Agentic Skills</strong>, extending the latest compute stack and agentic capabilities to Jetson Orin.
            </p>
          </div>
        </div>
        <div class="mt-8 text-center">
          <a href="https://developer.nvidia.com/embedded/jetson-linux" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 bg-nvidia-green text-nvidia-black font-bold rounded-lg hover:bg-nvidia-green/90 transition-all">
            Jetson Linux
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- =========================================================
       DEVKITS vs MODULES EXPLAINER
       ========================================================= -->
  <section id="devkits-vs-modules" class="py-16 bg-slate-50 border-b border-slate-200 scroll-mt-32">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl border-l-4 border-nvidia-green shadow-sm p-8">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-nvidia-green/10 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-nvidia-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-4">Developer Kits vs Modules: What's the difference?</h3>
            <div class="space-y-3">
              <p class="text-slate-700 text-sm leading-relaxed">
                <strong class="text-slate-900">Jetson Developer Kits</strong> accelerate application development and prototyping with a Jetson module on a reference carrier board, ready to build on out of the box.
              </p>
              <p class="text-slate-700 text-sm leading-relaxed">
                <strong class="text-slate-900">Jetson Modules</strong> help you get to market faster with production System-on-Modules you mount onto a carrier board designed for your end product.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       DEVELOPER KITS
       ========================================================= -->
  <section id="developer-kits" class="py-20 bg-white scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-sm font-semibold text-nvidia-green uppercase tracking-wider">Hardware</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-4">Developer Kits</h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">Reference platforms built for prototyping, evaluation, and software development. Start here to build on Jetson.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- AGX Thor Developer Kit -->
        <article class="group relative bg-white rounded-2xl border border-slate-200 hover:border-nvidia-green/50 hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col">
          <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-50 flex items-center justify-center p-6">
            <img src="/images/hero/isometric_jat-devkit.png" alt="Jetson AGX Thor Developer Kit" class="h-64 w-auto max-w-full object-contain drop-shadow-lg" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-medium text-nvidia-green bg-nvidia-green/10 px-2 py-0.5 rounded">New</span>
              <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded">Thor Generation</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-nvidia-green transition-colors">Jetson AGX Thor Developer Kit</h3>
            <ul class="text-sm text-slate-600 space-y-1.5 mb-5 flex-grow">
              <li>• 2070 TFLOPS (FP4 sparse) AI performance</li>
              <li>• 128GB LPDDR5X unified memory</li>
              <li>• 14-core Arm Neoverse-V3AE CPU</li>
              <li>• 40–130W power envelope</li>
            </ul>
            <div class="space-y-2 pt-4 border-t border-slate-100">
              <a href="https://www.nvidia.com/en-us/autonomous-machines/embedded-systems/jetson-thor/" target="_blank" rel="noopener" class="flex items-center justify-between text-base font-semibold text-nvidia-green hover:gap-3 transition-all">
                <span>Product page</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
              <a href="https://developer.nvidia.com/embedded/buy-jetson" target="_blank" rel="noopener" class="flex items-center justify-between text-base font-semibold text-slate-700 hover:text-nvidia-green hover:gap-3 transition-all">
                <span>Where to buy</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
              <a href="https://docs.nvidia.com/jetson/agx-thor-devkit/user-guide/latest/" target="_blank" rel="noopener" class="flex items-center justify-between text-base font-semibold text-slate-700 hover:text-nvidia-green hover:gap-3 transition-all">
                <span>Developer Kit - User Guide</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
            </div>
          </div>
        </article>

        <!-- AGX Orin Developer Kit -->
        <article class="group relative bg-white rounded-2xl border border-slate-200 hover:border-purple-400/60 hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col">
          <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-50 flex items-center justify-center p-6">
            <img src="/images/hero/isometric_jao-devkit.png" alt="Jetson AGX Orin Developer Kit" class="h-48 w-auto max-w-full object-contain drop-shadow-lg" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded">Orin Generation</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-purple-600 transition-colors">Jetson AGX Orin Developer Kit</h3>
            <ul class="text-sm text-slate-600 space-y-1.5 mb-5 flex-grow">
              <li>• Up to 275 TOPS AI performance</li>
              <li>• 64GB LPDDR5 unified memory</li>
              <li>• 12-core Arm Cortex-A78AE CPU</li>
              <li>• 15–60W power envelope</li>
            </ul>
            <div class="space-y-2 pt-4 border-t border-slate-100">
              <a href="https://www.nvidia.com/en-us/autonomous-machines/embedded-systems/jetson-orin/" target="_blank" rel="noopener" class="flex items-center justify-between text-base font-semibold text-purple-600 hover:gap-3 transition-all">
                <span>Product page</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
              <a href="https://developer.nvidia.com/embedded/buy-jetson" target="_blank" rel="noopener" class="flex items-center justify-between text-base font-semibold text-slate-700 hover:text-purple-600 hover:gap-3 transition-all">
                <span>Where to buy</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
              <a href="https://docs.nvidia.com/jetson/agx-orin-devkit/user-guide/latest/" target="_blank" rel="noopener" class="flex items-center justify-between text-base font-semibold text-slate-700 hover:text-purple-600 hover:gap-3 transition-all">
                <span>Developer Kit - User Guide</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Orin Nano Super Developer Kit -->
        <article class="group relative bg-white rounded-2xl border border-slate-200 hover:border-blue-400/60 hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col">
          <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-50 flex items-center justify-center p-6">
            <img src="/images/hero/isometric_jon-devkit.png" alt="Jetson Orin Nano Super Developer Kit" class="h-32 w-auto max-w-full object-contain drop-shadow-lg" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded">Orin Generation</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">Jetson Orin Nano Super Developer Kit</h3>
            <ul class="text-sm text-slate-600 space-y-1.5 mb-5 flex-grow">
              <li>• 67 TOPS (Super Mode) AI performance</li>
              <li>• 8GB LPDDR5 unified memory</li>
              <li>• 6-core Arm Cortex-A78AE CPU</li>
              <li>• 7–25W power envelope</li>
            </ul>
            <div class="space-y-2 pt-4 border-t border-slate-100">
              <a href="https://www.nvidia.com/en-us/autonomous-machines/embedded-systems/jetson-orin/" target="_blank" rel="noopener" class="flex items-center justify-between text-base font-semibold text-blue-600 hover:gap-3 transition-all">
                <span>Product page</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
              <a href="https://developer.nvidia.com/embedded/buy-jetson" target="_blank" rel="noopener" class="flex items-center justify-between text-base font-semibold text-slate-700 hover:text-blue-600 hover:gap-3 transition-all">
                <span>Where to buy</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
              <a href="https://developer.nvidia.com/embedded/learn/get-started-jetson-orin-nano-devkit" target="_blank" rel="noopener" class="flex items-center justify-between text-base font-semibold text-slate-700 hover:text-blue-600 hover:gap-3 transition-all">
                <span>Developer Kit - User Guide</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- =========================================================
       PRODUCTION MODULES (SoMs)
       ========================================================= -->
  <section id="modules" class="py-20 bg-slate-50 border-y border-slate-200 scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-sm font-semibold text-nvidia-green uppercase tracking-wider">Hardware</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-4">Production Modules</h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">System-on-Module (SOM) SKUs for shipping products, grouped by series.</p>
      </div>

      <!-- Thor series -->
      <div class="mb-12">

<script>
  function initializeAgentSkillsPage() {
    const root = document.querySelector('#agent-skills-page');
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-skill-filter]'));
    const skillRows = Array.from(root.querySelectorAll<HTMLElement>('[data-skill]'));
    const filterCount = root.querySelector<HTMLElement>('.filter-count');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.skillFilter;
        filterButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        let visible = 0;
        skillRows.forEach((row) => {
          const show = row.dataset.category === category;
          row.hidden = !show;
          if (show) visible += 1;
        });
        if (filterCount) filterCount.textContent = `${visible} shown`;
      });
    });

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-install-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-install-panel]'));
    function activateTab(next: number) {
      tabs.forEach((tab, index) => {
        const active = index === next;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, index) => { panel.hidden = index !== next; });
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activateTab(next);
        tabs[next].focus();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.dataset.copyValue || '';
        await navigator.clipboard.writeText(value);
        const status = button.matches('.prompt-chip') ? button.querySelector<HTMLElement>('.copy-mark') : button;
        if (!status) return;
        const original = status.textContent || '';
        status.textContent = 'COPIED';
        window.setTimeout(() => { status.textContent = original; }, 1400);
      });
    });
  }

  initializeAgentSkillsPage();
  document.addEventListener('astro:page-load', initializeAgentSkillsPage);
</script>

---
import Layout from '../../layouts/Layout.astro';
import {
  installTargets,
} from '../../data/jetson-agent-skills';
---

<Layout
  title="Jetson Agent Skills"
  description="Give AI coding agents Jetson-specific workflows for diagnostics, inference, video, optimization, and BSP development."
  image="/images/hero/jetson-family-line_50pcnt.png"
>
  <div id="agent-skills-page">
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="shell hero-layout">
        <div class="hero-copy">
          <a class="back-link" href="/tutorials/">← Jetson AI Lab</a>
          <p class="kicker"><span></span>NVIDIA Jetson developer tools</p>
          <h1>Give your coding agent<br /><strong>Jetson instincts.</strong></h1>
          <p class="hero-lede">
            Reusable, NVIDIA-verified workflows help AI coding agents inspect the real device,
            choose compatible software, run measured experiments, and customize the platform.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#install">Install Device Skills</a>
            <a class="button button-secondary" href="#choose">Choose a skill family</a>
          </div>
        </div>
      </div>
    </section>

    <nav class="page-nav" aria-label="On this page">
      <div class="shell nav-inner">
        <a href="#why">Why skills</a>
        <a href="#choose">Choose a path</a>
        <a href="#workflow">How it works</a>
        <a href="#install">Install</a>
      </div>
    </nav>

    <section id="why" class="section section-light">
      <div class="shell">
        <div class="section-heading heading-split">
          <div>
            <p class="kicker dark"><span></span>The missing platform layer</p>
            <h2>From general-purpose agent<br />to Jetson collaborator.</h2>
          </div>
          <p>
            A coding agent knows software. A Jetson skill adds the platform-specific procedure,
            live context, and boundaries needed to act usefully on edge AI hardware.
          </p>
        </div>
        <div class="capability-rail">
          {[
            ['01', 'Inspect', 'Read the actual module, release, memory, thermals, and services.'],
            ['02', 'Decide', 'Match runtimes, packages, and settings to the device in front of you.'],
            ['03', 'Execute', 'Use repeatable helpers for serving, benchmarking, video, and BSP work.'],
            ['04', 'Verify', 'Measure the result instead of assuming that a change worked.'],
          ].map(([number, title, description]) => (
            <article>
              <span>{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="choose" class="section section-graphite">
      <div class="shell">
        <div class="section-heading">
          <p class="kicker"><span></span>Choose your operating surface</p>
          <h2>One platform. Two skill families.</h2>
          <p>Start with the live device. Add BSP Skills only when your work begins before boot.</p>
        </div>

        <div class="family-grid">
          <article class="family-card family-primary">
            <div class="family-header">
              <span class="family-index">A / LIVE DEVICE</span>
              <span class="family-count">Application workflows</span>
            </div>
            <div class="family-icon" aria-hidden="true">
              <svg viewBox="0 0 96 96" fill="none">
                <rect x="18" y="18" width="60" height="60" rx="3"></rect>
                <rect x="30" y="30" width="36" height="36" rx="2"></rect>
                <path d="M6 32h12M6 48h12M6 64h12M78 32h12M78 48h12M78 64h12M32 6v12M48 6v12M64 6v12M32 78v12M48 78v12M64 78v12"></path>
              </svg>
            </div>
            <p class="family-tag">Recommended for most developers</p>
            <h3>Jetson Device Skills</h3>
            <p class="family-description">
              Run on a booted Jetson. Diagnose the system, recover memory, select packages,
              serve and benchmark models, and build accelerated video pipelines.
            </p>
            <dl class="family-facts">
              <div><dt>RUNS ON</dt><dd>Your Jetson</dd></div>
              <div><dt>BEST FOR</dt><dd>Application development</dd></div>
              <div><dt>AGENTS</dt><dd>Cursor · Codex · Claude · OpenClaw</dd></div>
            </dl>
            <a href="#install">Install Device Skills <span>→</span></a>
          </article>

          <article class="family-card">
            <div class="family-header">
              <span class="family-index">B / PRE-FLASH</span>
              <span class="family-count">Platform workflows</span>
            </div>
            <div class="family-icon family-icon-bsp" aria-hidden="true">
              <svg viewBox="0 0 96 96" fill="none">
                <path d="M17 23h62v50H17z"></path>
                <path d="M28 34h40v28H28zM8 31h9M8 47h9M8 63h9M79 31h9M79 47h9M79 63h9"></path>
                <circle cx="34" cy="48" r="5"></circle><path d="M45 43h14M45 50h14M45 57h9"></path>
              </svg>
            </div>
            <p class="family-tag">For custom hardware and production bring-up</p>
            <h3>Jetson BSP Skills</h3>
            <p class="family-description">
              Run on a host workstation against a Linux_for_Tegra tree. Configure pinmux,
              PCIe, UPHY, cameras, power, memory, builds, flashing, and validation.
            </p>
            <dl class="family-facts">
              <div><dt>RUNS ON</dt><dd>Host workstation</dd></div>
              <div><dt>BEST FOR</dt><dd>Platform customization</dd></div>
              <div><dt>AGENTS</dt><dd>Cursor · Codex · Claude</dd></div>
            </dl>
            <a href="https://github.com/NVIDIA-AI-IOT/jetson-bsp-skills" target="_blank" rel="noopener noreferrer">Open BSP repository <span>↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <section id="workflow" class="section section-signal">
      <div class="shell workflow-layout">
        <div class="section-heading">
          <p class="kicker dark"><span></span>The operating model</p>
          <h2>Reason broadly.<br />Act with device context.</h2>
          <p>
            Skills do not replace the agent or NVIDIA documentation. They connect reasoning
            to verified Jetson procedures and live measurements.
          </p>
        </div>
        <ol class="workflow-track">
          <li>
            <span class="workflow-number">01</span>
            <div><p class="workflow-label">YOU</p><h3>Describe the outcome</h3><p>Use natural language. Set boundaries and approve material changes.</p></div>
          </li>
          <li>
            <span class="workflow-number">02</span>
            <div><p class="workflow-label">CODING AGENT</p><h3>Plans and orchestrates</h3><p>Cursor, Codex, or Claude inspects the project and selects relevant skills.</p></div>
          </li>
          <li>
            <span class="workflow-number">03</span>
            <div><p class="workflow-label">JETSON SKILL</p><h3>Applies platform procedure</h3><p>Instructions and helpers gather live facts and execute bounded workflows.</p></div>
          </li>
          <li>
            <span class="workflow-number">04</span>
            <div><p class="workflow-label">MEASURED RESULT</p><h3>Returns evidence</h3><p>Review output from the target hardware before deciding what comes next.</p></div>
          </li>
        </ol>
      </div>

    </section>

    <section id="install" class="section section-install">
      <div class="shell install-layout">
        <div class="section-heading">
          <p class="kicker"><span></span>Start on the live device</p>
          <h2>Install once.<br />Use from every project.</h2>
          <p>
            Run this on your Jetson. The installer links the complete Device Skills catalog
            into the location your selected coding agent reads.
          </p>
          <div class="trust-note">
            <span>!</span>
            <p><strong>You stay in control.</strong> Review commands, downloads, service changes, and reboots before approval. NVIDIA documentation remains authoritative.</p>
          </div>
        </div>

        <div class="install-console">
          <div class="install-tabs" role="tablist" aria-label="Choose coding agent">
            {installTargets.map((target, index) => (
              <button
                type="button"
                role="tab"
                id={`install-tab-${target.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`install-panel-${target.id}`}
                tabindex={index === 0 ? 0 : -1}
                data-install-tab={target.id}
              >
                {target.label}
              </button>
            ))}
          </div>
          {installTargets.map((target, index) => (
            <div
              class="install-panel"
              id={`install-panel-${target.id}`}
              role="tabpanel"
              aria-labelledby={`install-tab-${target.id}`}
              hidden={index !== 0}
              data-install-panel={target.id}
            >
              <div class="console-meta">
                <span>RUN ON JETSON</span>
                <button type="button" data-copy-value={target.command}>COPY COMMAND</button>
              </div>
              <pre><code>{target.command}</code></pre>
            </div>
          ))}
          <div class="install-footer">
            <a href="https://github.com/NVIDIA-AI-IOT/jetson-device-skills" target="_blank" rel="noopener noreferrer">Source repository ↗</a>
            <span>Restart the agent after installation.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-links" aria-label="Related pages">
      <div class="shell cta-links-inner">
        <a class="cta-link" href="/tutorials/ai-assisted-development-on-jetson/">See AI-assisted development →</a>
        <a class="cta-link" href="/tutorials/reachy-mini-jetson-assistant/">See how the Reachy Mini Jetson Assistant app was built →</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  :root {
    --signal: #76b900;
    --signal-bright: #a7ef1f;
    --ink: #090c0b;
    --graphite: #111614;
    --steel: #9ba49f;
    --fog: #edf0ed;
    --paper: #f7f8f5;
  }
  #agent-skills-page { color: var(--ink); background: var(--paper); }
  .shell { width: min(100% - 2rem, 80rem); margin-inline: auto; }
  .hero { position: relative; overflow: hidden; color: white; background: var(--ink); }
  .hero::after { position: absolute; inset: auto -8rem -12rem auto; width: 34rem; height: 34rem; border: 1px solid rgba(118,185,0,.3); border-radius: 50%; box-shadow: 0 0 0 5rem rgba(118,185,0,.025), 0 0 0 10rem rgba(118,185,0,.02); content: ''; }
  .hero-grid { position: absolute; inset: 0; opacity: .14; background-image: linear-gradient(rgba(255,255,255,.16) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.16) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to right, black, transparent 78%); }
  .hero-layout { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr .95fr; min-height: 720px; align-items: center; gap: clamp(3rem, 7vw, 7rem); padding-block: 5rem; }
  .hero-layout > *, .workflow-layout > *, .install-layout > * { min-width: 0; }
  .back-link { display: inline-block; margin-bottom: 4.5rem; color: #b7beb9; font: 600 .75rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .1em; text-transform: uppercase; }
  .back-link:hover { color: white; }
  .kicker { display: flex; align-items: center; gap: .7rem; color: #d7ddd8; font: 700 .7rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .15em; text-transform: uppercase; }
  .kicker span { width: 1.75rem; height: 2px; background: var(--signal); }
  .kicker.dark { color: #506057; }
  h1, h2, h3, p { margin: 0; }
  h1 { margin-top: 1.25rem; font-size: clamp(3rem, 5.9vw, 5.75rem); font-weight: 300; line-height: .98; letter-spacing: -.065em; text-wrap: balance; }
  h1 strong { color: var(--signal-bright); font-weight: 750; }
  .hero-lede { max-width: 39rem; margin-top: 2rem; color: #b8c1bc; font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.7; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.25rem; }
  .button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: .75rem 1.2rem; font-size: .85rem; font-weight: 750; text-decoration: none; }
  .button-primary { color: #071006; background: var(--signal-bright); }
  .button-primary:hover { background: white; }
  .button-secondary { color: white; border: 1px solid #53605a; background: rgba(255,255,255,.03); }
  .button-secondary:hover { border-color: white; }
  .signal-row { display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; margin: 3.5rem 0 0; padding: 0; color: #9ca7a1; font: 600 .68rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; list-style: none; }
  .signal-row li { display: flex; gap: .6rem; }
  .signal-row span { color: var(--signal-bright); }
  .terminal-wrap { position: relative; border: 1px solid #39423e; background: rgba(9, 13, 11, .84); box-shadow: 24px 24px 0 rgba(118,185,0,.08); backdrop-filter: blur(12px); }
  .terminal-wrap::before { position: absolute; top: -1px; left: -1px; width: 4px; height: 42%; background: var(--signal); content: ''; }
  .terminal-top { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid #313a35; color: #9aa49f; font: 700 .64rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .09em; }
  .live-indicator { display: flex; align-items: center; gap: .5rem; color: #d6e6d3; }
  .live-indicator i { width: 6px; height: 6px; border-radius: 50%; background: var(--signal-bright); box-shadow: 0 0 0 4px rgba(167,239,31,.12); }
  .terminal-body { padding: clamp(1.25rem, 3vw, 2rem); font: .78rem/1.7 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .terminal-muted { color: #6f7a74; }
  .terminal-prompt { margin-top: .5rem; color: #eef5f0; font-size: .88rem; }
  .terminal-rule { height: 1px; margin: 1.5rem 0; background: #26302b; }
  .terminal-line { margin-top: .45rem; color: #aab5af; }
  .terminal-line span { color: var(--signal-bright); }
  .terminal-line b { color: white; font-weight: 500; }
  .device-readout { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 1.5rem 0; background: #2b342f; }
  .device-readout div { padding: .9rem; background: #111713; }
  .device-readout dt { color: #66726b; font-size: .62rem; letter-spacing: .1em; }
  .device-readout dd { margin: .25rem 0 0; color: #e6ece8; }
  .terminal-result { padding: .8rem; color: #b7c2bc; border: 1px solid rgba(118,185,0,.24); background: rgba(118,185,0,.06); }
  .terminal-result span { margin-right: .7rem; color: var(--signal-bright); font-weight: 800; }
  .page-nav { position: sticky; top: 4rem; z-index: 30; border-bottom: 1px solid #dce2dd; background: rgba(247,248,245,.94); backdrop-filter: blur(12px); }
  .nav-inner { display: flex; overflow-x: auto; }
  .nav-inner a { flex: 0 0 auto; padding: 1rem 1.25rem; color: #4d5952; border-left: 1px solid #dce2dd; font: 700 .68rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .nav-inner a:last-child { border-right: 1px solid #dce2dd; }
  .nav-inner a:hover { color: #0b0f0d; background: #e9f2e1; }
  .section { padding-block: clamp(5rem, 9vw, 8rem); scroll-margin-top: 8rem; }
  .section-light { background: var(--paper); }
  .section-graphite { color: white; background: var(--graphite); }
  .section-heading { max-width: 46rem; }
  .section-heading h2 { margin-top: 1.1rem; font-size: clamp(2.4rem, 4.5vw, 4.4rem); font-weight: 350; line-height: 1.02; letter-spacing: -.055em; text-wrap: balance; }
  .section-heading > p:last-child { max-width: 38rem; margin-top: 1.5rem; color: #66726c; font-size: 1.05rem; line-height: 1.75; }
  .section-graphite .section-heading > p:last-child, .section-install .section-heading > p:last-child { color: #aab4ae; }
  .heading-split { display: grid; grid-template-columns: 1.2fr .8fr; max-width: none; align-items: end; gap: 4rem; }
  .heading-split > p:last-child { margin: 0; }
  .capability-rail { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 5rem; border-top: 1px solid #ccd3ce; border-bottom: 1px solid #ccd3ce; }
  .capability-rail article { min-height: 270px; padding: 1.5rem; border-left: 1px solid #ccd3ce; }
  .capability-rail article:last-child { border-right: 1px solid #ccd3ce; }
  .capability-rail span { color: #728078; font: 700 .7rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .capability-rail h3 { margin-top: 4.5rem; font-size: 1.65rem; letter-spacing: -.03em; }
  .capability-rail p { margin-top: 1rem; color: #66726c; font-size: .9rem; line-height: 1.65; }
  .family-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: 4rem; background: #3c4641; }
  .family-card { position: relative; padding: clamp(1.5rem, 4vw, 3rem); background: #181e1b; }
  .family-card::after { position: absolute; inset: 0; border: 1px solid transparent; pointer-events: none; content: ''; transition: border-color .2s; }
  .family-card:hover::after { border-color: #65716b; }
  .family-primary { background: #1b241c; }
  .family-primary::before { position: absolute; inset: 0 auto auto 0; width: 42%; height: 3px; background: var(--signal-bright); content: ''; }
  .family-header { display: flex; justify-content: space-between; gap: 1rem; color: #85918b; font: 700 .66rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .1em; }
  .family-count { color: #c1cbc5; }
  .family-icon { width: 6rem; margin: 3.5rem 0 2.5rem; color: var(--signal-bright); }
  .family-icon svg { width: 100%; stroke: currentColor; stroke-width: 1.3; }
  .family-icon-bsp { color: #dbe2dd; }
  .family-tag { color: var(--signal-bright); font: 700 .68rem/1.4 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .family-card h3 { margin-top: .75rem; font-size: clamp(1.8rem, 3vw, 2.6rem); letter-spacing: -.045em; }
  .family-description { max-width: 34rem; min-height: 6.5rem; margin-top: 1.25rem; color: #aab4ae; line-height: 1.7; }
  .family-facts { margin: 2rem 0; border-top: 1px solid #36403b; }
  .family-facts div { display: grid; grid-template-columns: 7rem 1fr; padding: .8rem 0; border-bottom: 1px solid #303934; }
  .family-facts dt { color: #77837c; font: 700 .64rem/1.4 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; }
  .family-facts dd { margin: 0; color: #d6ded9; font-size: .82rem; }
  .family-card > a { display: inline-flex; gap: 1rem; color: white; font-size: .85rem; font-weight: 750; }
  .family-card > a span { color: var(--signal-bright); }
  .catalog-heading { align-items: center; }
  .filter-bar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-top: 4rem; padding: .75rem; border: 1px solid #ccd3ce; background: #eef1ed; }
  .filter-button { min-height: 40px; padding: .65rem .9rem; color: #4d5952; border: 0; background: transparent; font: 700 .7rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; text-transform: uppercase; cursor: pointer; }
  .filter-button:hover { color: #0a0d0b; background: #dde4de; }
  .filter-button.active { color: white; background: var(--ink); }
  .filter-count { margin-left: auto; padding: .5rem; color: #607067; font: 700 .68rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .skill-list { margin-top: 1.25rem; border-top: 1px solid #bcc5bf; }
  .skill-row { display: grid; grid-template-columns: 3rem minmax(0, 1fr) 6rem; gap: 1rem; align-items: start; padding: 1.25rem 1rem; border-bottom: 1px solid #ccd3ce; transition: background .15s, padding-left .15s; }
  .skill-row:hover { padding-left: 1.35rem; background: white; }
  .skill-row[hidden] { display: none; }
  .skill-number { color: #8b968f; font: 700 .65rem/1.5 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .skill-name-line { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .skill-name-line h3 { font: 700 .9rem/1.3 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .skill-row p { max-width: 48rem; margin-top: .45rem; color: #66726c; font-size: .85rem; line-height: 1.55; }
  .family-pill { padding: .25rem .45rem; color: #536059; border: 1px solid #bdc6c0; font: 700 .55rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; }
  .family-pill.device { color: #365e18; border-color: #a9c990; background: #edf7e5; }
  .skill-category { justify-self: end; color: #6c7871; font: 700 .6rem/1.5 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .catalog-note { margin-top: 1.25rem; color: #69756e; font-size: .82rem; text-align: right; }
  .catalog-note a { color: #315d11; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .section-signal { overflow: hidden; background: var(--signal); }
  .workflow-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .section-signal .section-heading > p:last-child { color: #1e3a0d; }
  .workflow-track { position: relative; margin: 0; padding: 0; list-style: none; }
  .workflow-track::before { position: absolute; top: 1.4rem; bottom: 1.4rem; left: 1.4rem; width: 1px; background: rgba(7,16,6,.35); content: ''; }
  .workflow-track li { position: relative; display: grid; grid-template-columns: 3rem 1fr; gap: 1.25rem; padding-bottom: 2rem; }
  .workflow-number { position: relative; z-index: 1; display: grid; width: 2.8rem; height: 2.8rem; place-items: center; color: white; background: var(--ink); font: 700 .68rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .workflow-label { color: #315416; font: 800 .62rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .1em; }
  .workflow-track h3 { margin-top: .35rem; font-size: 1.25rem; letter-spacing: -.02em; }
  .workflow-track div > p:last-child { max-width: 30rem; margin-top: .5rem; color: #25430f; font-size: .86rem; line-height: 1.55; }
  .prompt-strip { margin-top: 5rem; border-top: 1px solid rgba(8,17,7,.3); }
  .prompt-strip-label { padding: 1rem 0; color: #24410f; font: 800 .65rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .12em; }
  .prompt-list { border-top: 1px solid rgba(8,17,7,.3); }
  .prompt-chip { display: grid; width: 100%; grid-template-columns: 2.5rem 1fr 4rem; gap: 1rem; padding: 1.25rem 0; color: var(--ink); border: 0; border-bottom: 1px solid rgba(8,17,7,.3); background: transparent; text-align: left; cursor: pointer; }
  .prompt-chip > span:first-child, .copy-mark { font: 800 .65rem/1.5 ui-monospace, SFMono-Regular, Consolas, monospace; }
  .prompt-text { font-weight: 650; }
  .copy-mark { justify-self: end; }
  .prompt-chip:hover .prompt-text { text-decoration: underline; text-underline-offset: 4px; }

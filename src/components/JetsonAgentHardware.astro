<figure class="hardware-figure" aria-labelledby="hardware-figure-caption">
  <svg viewBox="0 0 960 600" role="img" aria-labelledby="hardware-title hardware-description">
    <title id="hardware-title">A coding agent working with real Jetson hardware</title>
    <desc id="hardware-description">A coding agent, project files, and device tools run on the Jetson, shown together in one pale green region. Separate lines with green dots represent connections to a camera, a distance sensor, and a robot arm. These are schematic device connections, not physical cable routing.</desc>

    <!-- Shared containment means software runs on Jetson. No device-style
         connector joins the software card to the board. -->
    <rect x="275" y="24" width="400" height="514" rx="26" fill="#f0f5e9" />
    <rect x="297" y="48" width="356" height="112" rx="14" fill="#202925" />
    <text x="475" y="94" text-anchor="middle" class="agent-title">Coding agent on Jetson</text>
    <text x="475" y="132" text-anchor="middle" class="agent-subtitle">Project + device tools</text>

    <!-- Device links are schematic, not a claim about specific ports/protocols. -->
    <g class="device-connections" aria-hidden="true">
      <path d="M228 252H251V341H311" />
      <path d="M200 459H248V412H311" />
      <path d="M641 390H707V440H754" />
    </g>
    <g fill="#76b900" aria-hidden="true">
      <circle cx="251" cy="296" r="5" />
      <circle cx="248" cy="438" r="5" />
      <circle cx="707" cy="415" r="5" />
    </g>

    <image href="/images/hero/isometric_jon-devkit.png" x="291" y="219" width="372" height="260" />
    <image href="/images/ai-assisted-development/isometric-camera.svg" x="22" y="155" width="212" height="171" />
    <image href="/images/ai-assisted-development/isometric-distance-sensor.svg" x="70" y="384" width="121" height="123" />
    <image href="/images/ai-assisted-development/isometric-robot-arm.svg" x="734" y="168" width="209" height="337" />

    <text x="128" y="362" text-anchor="middle" class="device-label">Camera</text>
    <text x="131" y="551" text-anchor="middle" class="device-label">Distance sensor</text>
    <text x="837" y="551" text-anchor="middle" class="device-label">Robot arm</text>
    <text x="475" y="508" text-anchor="middle" class="agent-loop">Inspect → Run → Measure</text>
  </svg>
  <figcaption id="hardware-figure-caption">Agent tools run on Jetson. AI models can run locally or in the cloud.</figcaption>
</figure>

<style>
  .hardware-figure { border: 1px solid #e2e8f0; border-radius: 1.25rem; background: #fbfcfa; overflow: hidden; }

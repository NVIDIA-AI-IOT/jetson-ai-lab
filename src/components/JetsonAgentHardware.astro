  .device-connections { fill: none; stroke: #9cae9f; stroke-width: 2.5; stroke-linejoin: round; }
  .device-label { fill: #273a30; font-size: 28px; font-weight: 600; }
  figcaption { padding: 1rem 1.5rem; border-top: 1px solid #e2e8f0; color: #64748b; font-size: .75rem; line-height: 1.65; }
</style>

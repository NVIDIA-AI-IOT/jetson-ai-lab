{
  "name": "jetson-ai-lab-redesign",
  "type": "module",
  "version": "1.0.0",
  "description": "Official NVIDIA experience for running Jetson-optimized generative AI models locally",
  "author": "NVIDIA Corporation",
  "license": "MIT",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run check:model-metadata && npm run test:model-freshness",
    "build": "astro build",
    "postbuild": "npm run test:llms-full && npm run check:llms-full",
    "preview": "astro preview",
    "check:model-metadata": "node scripts/check-model-catalog-metadata.mjs",
    "check:llms-full": "node scripts/check-llms-full-output.mjs",
    "test:model-freshness": "tsx scripts/test-model-freshness.mjs",
    "check:model-visuals": "node scripts/check-model-family-visuals.mjs",
    "build:model-visuals": "node scripts/render-model-visuals-webgl.mjs && node scripts/render-gemma-visuals-webgl.mjs && node scripts/render-nvidia-visuals-webgl.mjs && node scripts/render-additional-visuals-webgl.mjs && npm run check:model-visuals",
    "benchmark:model-shaders": "node scripts/benchmark-model-shaders.mjs",
    "benchmark:layered-shaders": "node scripts/benchmark-layered-model-shaders.mjs",
    "benchmark:all-model-shaders": "npm run benchmark:model-shaders && npm run benchmark:layered-shaders",
    "test:models-ui": "node scripts/test-model-catalog.mjs",
    "astro": "astro",
    "test:llms-full": "node --test scripts/test-llms-full-output.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^5.11.1",
    "chart.js": "^4.4.4",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.0.0",
    "playwright": "^1.57.0",
    "rehype-mermaid": "^3.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6"
  },
  "keywords": [
    "jetson",
    "ai",
    "nvidia",
    "llm",
    "whisper",
    "sdxl",
    "llama",
    "edge-computing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NVIDIA-AI-IOT/jetson-ai-lab.git"
  },
  "homepage": "https://www.jetson-ai-lab.com"
}
